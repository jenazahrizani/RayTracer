  function updateClock(): void {
    const now =
      new Date();

    const h =
      String(
        now.getHours(),
      ).padStart(
        2,
        "0",
      );

    const m =
      String(
        now.getMinutes(),
      ).padStart(
        2,
        "0",
      );

    const s =
      String(
        now.getSeconds(),
      ).padStart(
        2,
        "0",
      );

    clockState.textContent =
      `${h}:${m}:${s}`;
  }


  /* =========================================================================
     COMMAND INPUT
     ========================================================================= */

  mainCommand.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key ===
        "Enter"
      ) {
        event.preventDefault();

        const value =
          mainCommand.value.trim();

        if (!value) {
          return;
        }

        executeCommand(
          value,
        );

        mainCommand.value =
          "";

        return;
      }

      if (
        event.key ===
        "ArrowUp"
      ) {
        event.preventDefault();

        if (
          !history.length
        ) {
          return;
        }

        historyIndex =
          Math.min(
            historyIndex + 1,
            history.length - 1,
          );

        mainCommand.value =
          history[
            historyIndex
          ] ?? "";

        mainCommand.setSelectionRange(
          mainCommand.value.length,
          mainCommand.value.length,
        );

        return;
      }

      if (
        event.key ===
        "ArrowDown"
      ) {
        event.preventDefault();

        if (
          !history.length
        ) {
          return;
        }

        historyIndex =
          Math.max(
            historyIndex - 1,
            -1,
          );

        mainCommand.value =
          historyIndex >=
          0
            ? history[
                historyIndex
              ] ?? ""
            : "";

        return;
      }
    },
  );


  /* =========================================================================
     EXEC BUTTON
     ========================================================================= */

  submitButton.addEventListener(
    "click",
    () => {
      const value =
        mainCommand.value.trim();

      if (!value) {
        mainCommand.focus();

        return;
      }

      executeCommand(
        value,
      );

      mainCommand.value =
        "";

      mainCommand.focus();
    },
  );


  /* =========================================================================
     FUNCTION KEYS
     ========================================================================= */

  window.addEventListener(
    "keydown",
    (event) => {
      if (
        event.ctrlKey ||
        event.altKey ||
        event.metaKey
      ) {
        return;
      }

      if (
        event.key ===
        "F1"
      ) {
        event.preventDefault();

        renderHelp();

        return;
      }

      if (
        event.key ===
        "F3"
      ) {
        event.preventDefault();

        executeCommand(
          "EXIT",
        );

        return;
      }

      if (
        event.key ===
        "F4"
      ) {
        event.preventDefault();

        executeCommand(
          "CONTROL",
        );

        return;
      }

      if (
        event.key ===
        "F6"
      ) {
        event.preventDefault();

        executeCommand(
          "BENCH",
        );

        return;
      }

      if (
        event.key ===
        "Escape"
      ) {
        mainCommand.value =
          "";

        mainCommand.focus();
      }
    },
  );


  /* =========================================================================
     RENDERER READY
     ========================================================================= */

  window.addEventListener(
    "raytracer:renderer-ready",
    () => {
      runtimeReady =
        true;

      setConnection(
        "READY",
        "ready",
      );

      setStatus(
        "READY",
      );

      renderMainScreen();

      mainCommand.focus();
    },
  );


  /* =========================================================================
     AI STATE
     ========================================================================= */

  window.addEventListener(
    "raytracer:ai-state",
    (event) => {
      const detail =
        (
          event as CustomEvent<
            Record<
              string,
              unknown
            >
          >
        ).detail ?? {};

      const state =
        upper(
          detail.state,
        );

      if (
        state ===
        "ERROR"
      ) {
        setStatus(
          "AI ERROR",
        );

        return;
      }

      if (
        state ===
        "RUNNING"
      ) {
        setStatus(
          "RUNNING",
        );

        return;
      }

      if (
        state ===
        "COMPLETE"
      ) {
        setStatus(
          "COMPLETE",
        );

        return;
      }

      if (
        detail.status
      ) {
        setStatus(
          String(
            detail.status,
          ),
        );
      }
    },
  );


  /* =========================================================================
     AI ERROR
     ========================================================================= */

  window.addEventListener(
    "raytracer:ai-error",
    (event) => {
      const detail =
        (
          event as CustomEvent<
            Record<
              string,
              unknown
            >
          >
        ).detail ?? {};

      runtimeReady =
        false;

      setConnection(
        "ERROR",
        "error",
      );

      setStatus(
        "ERROR",
      );

      message(
        `RUNTIME ERROR ===> ${
          String(
            detail.error ??
              "UNKNOWN ERROR",
          )
        }`,
        "error",
      );
    },
  );


  /* =========================================================================
     RUNTIME EVENTS
     ========================================================================= */

  window.addEventListener(
    "raytracer:run",
    () => {
      setStatus(
        "RUNNING",
      );

      message(
        "AUTONOMOUS RUN ACTIVE",
        "ok",
      );
    },
  );

  window.addEventListener(
    "raytracer:stop",
    () => {
      setStatus(
        "STOPPED",
      );

      message(
        "RUNTIME STOPPED",
        "warn",
      );
    },
  );

  window.addEventListener(
    "raytracer:training-start",
    () => {
      setStatus(
        "TRAINING",
      );

      message(
        "AI TRAINING ACTIVE",
        "ok",
      );
    },
  );

  window.addEventListener(
    "raytracer:training-complete",
    () => {
      setStatus(
        "COMPLETE",
      );

      message(
        "AI TRAINING COMPLETE",
        "ok",
      );
    },
  );

  window.addEventListener(
    "raytracer:training-stop",
    () => {
      setStatus(
        "STOPPED",
      );

      message(
        "AI TRAINING STOPPED",
        "warn",
      );
    },
  );

  window.addEventListener(
    "raytracer:controls-open",
    () => {
      setStatus(
        "CONTROL",
      );
    },
  );

  window.addEventListener(
    "raytracer:benchmark-open",
    () => {
      setStatus(
        "BENCH",
      );
    },
  );


  /* =========================================================================
     PRESET
     ========================================================================= */

  window.addEventListener(
    "raytracer:preset",
    (event) => {
      const detail =
        (
          event as CustomEvent<{
            preset?: unknown;
          }>
        ).detail;

      if (
        detail?.preset
      ) {
        message(
          `PRESET ===> ${upper(
            detail.preset,
          )}`,
          "ok",
        );
      }
    },
  );


  /* =========================================================================
     CONTROL FORWARDING
     ========================================================================= */

  window.addEventListener(
    "raytracer:controls-command",
    (event) => {
      const detail =
        (
          event as CustomEvent<{
            command?: unknown;
          }>
        ).detail;

      if (
        detail?.command
      ) {
        message(
          `FORWARDED ===> ${String(
            detail.command,
          )}`,
          "info",
        );
      }
    },
  );


  /* =========================================================================
     GPU / RENDERER
     ========================================================================= */

  window.addEventListener(
    "raytracer:gpu",
    (event) => {
      const detail =
        (
          event as CustomEvent<
            Record<
              string,
              unknown
            >
          >
        ).detail ?? {};

      if (
        detail.available
      ) {
        message(
          "GPU CAPABILITY DETECTED",
          "ok",
        );
      }
    },
  );


  /* =========================================================================
     INITIAL STATE
     ========================================================================= */

  setConnection(
    "INIT",
    "wait",
  );

  setStatus(
    "READY",
  );

  renderMainScreen();
  updateClock();

  window.setInterval(
    updateClock,
    1000,
  );

  window.setTimeout(
    () => {
      if (
        !runtimeReady
      ) {
        message(
          "WAITING FOR RUST WASM ENGINE",
          "warn",
        );
      }
    },
    1500,
  );
</script>
```
