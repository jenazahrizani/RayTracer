          "index",
      },
    );
  }

  function executeCommand(
    input: string,
  ): boolean {
    const raw =
      input.trim();

    if (!raw) {
      return false;
    }

    const command =
      upper(raw);

    history.unshift(
      raw,
    );

    if (
      history.length >
      100
    ) {
      history.length =
        100;
    }

    historyIndex =
      -1;

    if (
      command === "HELP" ||
      command === "?"
    ) {
      renderHelp();

      return true;
    }

    if (
      command === "EXIT" ||
      command === "QUIT" ||
      command === "CLOSE"
    ) {
      dispatch(
        "raytracer:stop",
        {
          source:
            "index",
        },
      );

      setStatus(
        "EXIT REQUESTED",
      );

      message(
        "EXIT REQUEST SENT TO RUNTIME",
        "warn",
      );

      return true;
    }

    if (
      command === "CONTROL" ||
      command === "CONTROLS" ||
      command === "EDIT"
    ) {
      sendControlsOpen();

      setStatus(
        "CONTROL OPEN",
      );

      message(
        "CONTROL MEMBER OPEN REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "BENCH" ||
      command === "BENCHMARK"
    ) {
      sendBenchmarkOpen();

      setStatus(
        "BENCH OPEN",
      );

      message(
        "BENCHMARK MEMBER OPEN REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "RUN"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "RUN",

          source:
            "index",
        },
      );

      setStatus(
        "RUN REQUESTED",
      );

      message(
        "AUTONOMOUS RUNTIME START REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command === "TRAIN"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "START_TRAINING",

          source:
            "index",
        },
      );

      setStatus(
        "TRAIN REQUESTED",
      );

      message(
        "AI CONTINUOUS TRAINING REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command.startsWith(
        "TRAIN ",
      )
    ) {
      const parts =
        command.split(
          /\s+/,
        );

      const count =
        Math.max(
          1,
          Number.parseInt(
            parts[1] ??
              "250",
            10,
          ) || 250,
        );

      dispatch(
        "raytracer:ai",
        {
          action:
            "TRAIN_STEPS",

          count,

          source:
            "index",
        },
      );

      setStatus(
        `TRAIN ${count}`,
      );

      message(
        `AI TRAIN REQUESTED / ${count} STEPS`,
        "ok",
      );

      return true;
    }

    if (
      command === "STEP"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "STEP",

          source:
            "index",
        },
      );

      setStatus(
        "AI STEP",
      );

      message(
        "SINGLE AI STEP REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "EVAL"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "EVALUATE",

          count:
            10,

          source:
            "index",
        },
      );

      setStatus(
        "EVAL REQUESTED",
      );

      message(
        "AI EVALUATION REQUESTED / 10 EPISODES",
        "info",
      );

      return true;
    }

    if (
      command.startsWith(
        "EVAL ",
      )
    ) {
      const parts =
        command.split(
          /\s+/,
        );

      const count =
        Math.max(
          1,
          Number.parseInt(
            parts[1] ??
              "10",
            10,
          ) || 10,
        );

      dispatch(
        "raytracer:ai",
        {
          action:
            "EVALUATE",

          count,

          source:
            "index",
        },
      );

      setStatus(
        `EVAL ${count}`,
      );

      message(
        `AI EVALUATION REQUESTED / ${count} EPISODES`,
        "info",
      );

      return true;
    }

    if (
      command === "RESET"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "RESET_AI",

          source:
            "index",
        },
      );

      setStatus(
        "AI RESET",
      );

      message(
        "AI NETWORK RESET REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command === "ENV" ||
      command === "ENV RESET"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "RESET_ENVIRONMENT",

          seed:
            Date.now() >>> 0,

          source:
            "index",
        },
      );

      setStatus(
        "ENV RESET",
      );

      message(
        "NEW ENVIRONMENT REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command.startsWith(
        "ENV ",
      )
    ) {
      const parts =
        command.split(
          /\s+/,
        );

      const seed =
        Number.parseInt(
          parts[1] ??
            "",
          10,
        );

      dispatch(
        "raytracer:ai",
        {
          action:
            "RESET_ENVIRONMENT",

          seed:
            Number.isFinite(
              seed,
            )
              ? seed >>> 0
              : Date.now() >>> 0,

          source:
            "index",
        },
      );

      setStatus(
        "ENV RESET",
      );

      message(
        "ENVIRONMENT RESET REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command === "STOP"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "STOP",

          source:
            "index",
        },
      );

      setStatus(
        "STOP REQUESTED",
      );

      message(
        "RUNTIME STOP REQUESTED",
        "warn",
      );

      return true;
    }

    if (
      command === "STATUS"
    ) {
      dispatch(
        "raytracer:controls-status",
        {
          source:
            "index",
        },
      );

      dispatch(
        "raytracer:ai",
        {
          action:
            "STATUS",

          source:
            "index",
        },
      );

      setStatus(
        "STATUS REQUESTED",
      );

      message(
        "STATUS REQUEST SENT",
        "info",
      );

      return true;
    }

    if (
      command === "VIEW"
    ) {
      dispatch(
        "raytracer:view",
        {
          source:
            "index",
        },
      );

      setStatus(
        "VIEW",
      );

      message(
        "WORLD VIEW REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "MODEL SAVE"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "SAVE_MODEL",

          source:
            "index",
        },
      );

      setStatus(
        "MODEL SAVE",
      );

      message(
        "MODEL SAVE REQUESTED",
        "ok",
      );

      return true;
    }

    if (
      command === "MODEL LOAD"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "LOAD_MODEL",

          source:
            "index",
        },
      );

      setStatus(
        "MODEL LOAD",
      );

      message(
        "MODEL LOAD REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "MODEL EXPORT"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "EXPORT_MODEL",

          source:
            "index",
        },
      );

      setStatus(
        "MODEL EXPORT",
      );

      message(
        "MODEL EXPORT REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "MODEL IMPORT"
    ) {
      dispatch(
        "raytracer:ai",
        {
          action:
            "IMPORT_MODEL",

          source:
            "index",
        },
      );

      setStatus(
        "MODEL IMPORT",
      );

      message(
        "MODEL IMPORT REQUESTED",
        "info",
      );

      return true;
    }

    if (
      command === "CLEAR" ||
      command === "CLS"
    ) {
      mainScreen.innerHTML =
        "";

      message(
        "MAIN SCREEN CLEARED",
        "ok",
      );

      return true;
    }

    if (
      command.startsWith(
        "PRESET ",
      )
    ) {
      const preset =
        command.split(
          /\s+/,
        )[1] ??
        "";

      dispatch(
        "raytracer:preset",
        {
          preset,

          source:
            "index",
        },
      );

      setStatus(
        `PRESET ${preset}`,
      );

      message(
        `PRESET ${preset} REQUESTED`,
        "ok",
      );

      return true;
    }

    if (
      command.startsWith(
        "SET ",
      )
    ) {
      dispatch(
        "raytracer:controls-command",
        {
          command,

          source:
            "index",
        },
      );

      setStatus(
        "CONTROL COMMAND",
      );

      message(
        `FORWARD ===> ${command}`,
        "info",
      );

      return true;
    }

    message(
      `INVALID COMMAND ===> ${raw}`,
      "error",
    );

    setStatus(
      "ERROR",
    );

    return false;
  }

