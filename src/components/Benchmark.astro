---
const { autoOpen = false } = Astro.props;
---

<section
  id="benchmark"
  class:list={{
    benchmark: true,
    "benchmark-visible": autoOpen,
  }}
  aria-hidden={!autoOpen}
>
  <div class="benchmark-shell">
    <header class="bench-header">
      <div class="bench-title">
        <span class="cyan">RAYTRC.BENCH</span>
        <span class="gray">/</span>
        <span class="white">AI TRAINING MONITOR</span>
        <span class="gray">/</span>
        <span class="green">TELEMETRY</span>
      </div>

      <div class="bench-state">
        <span id="bench-mode">MODE ===&gt; READY</span>
        <span id="bench-state">STATE ===&gt; IDLE</span>
      </div>
    </header>

    <div class="bench-command">
      <span class="command-prefix">COMMAND ===&gt;</span>

      <input
        id="bench-command-input"
        class="bench-command-input"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        aria-label="Benchmark command"
      />

      <button id="bench-command-submit" class="bench-command-button" type="button">
        EXEC
      </button>
    </div>

    <div class="bench-ruler">
      <span>0001</span>
      <span>+....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8</span>
      <span>SCROLL ===&gt; CSR</span>
    </div>

    <main id="bench-screen" class="bench-screen">
      <!-- TELEMETRY IS GENERATED BY SCRIPT -->
    </main>

    <footer class="bench-footer">
      <div id="bench-footer-left">
        <span class="gray">RAYTRC.BENCH</span>
        <span class="cyan">READY</span>
      </div>

      <div id="bench-footer-right">
        <span class="gray">COMMAND ===&gt;</span>
        <span class="white">HELP</span>
      </div>
    </footer>
  </div>
</section>

<style>
  .benchmark {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    background: #000;
    color: #d0d0d0;
    font-family:
      "IBM Plex Mono",
      "Courier New",
      Consolas,
      monospace;
    font-size: 12px;
    line-height: 1.35;
  }

  .benchmark.benchmark-visible {
    display: block;
  }

  .benchmark-shell {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows:
      auto
      auto
      auto
      minmax(0, 1fr)
      auto;
    background: #000;
    overflow: hidden;
  }

  .bench-header {
    min-height: 35px;
    padding: 6px 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    border-bottom: 1px solid #303030;
    background: #050505;
    white-space: nowrap;
    overflow: hidden;
  }

  .bench-title,
  .bench-state {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .bench-title {
    overflow: hidden;
  }

  .bench-state {
    flex-shrink: 0;
  }

  .bench-command {
    min-height: 34px;
    padding: 5px 10px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid #202020;
  }

  .command-prefix {
    color: #00dddd;
    white-space: nowrap;
  }

  .bench-command-input {
    width: 100%;
    min-width: 0;
    height: 25px;
    padding: 3px 7px;
    border: 1px solid #303030;
    outline: none;
    background: #000;
    color: #fff;
    font: inherit;
    text-transform: uppercase;
    caret-color: #00d400;
  }

  .bench-command-input:focus {
    border-color: #00d400;
    box-shadow: inset 0 0 0 1px #002800;
  }

  .bench-command-input::selection {
    background: #00d400;
    color: #000;
  }

  .bench-command-button {
    height: 25px;
    min-width: 75px;
    border: 1px solid #00d400;
    background: #000;
    color: #00d400;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .bench-command-button:hover {
    background: #001900;
  }

  .bench-command-button:active {
    background: #00d400;
    color: #000;
  }

  .bench-ruler {
    min-height: 20px;
    padding: 2px 10px;
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    border-bottom: 1px solid #181818;
    color: #555;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
  }

  .bench-ruler span:nth-child(2) {
    overflow: hidden;
  }

  .bench-screen {
    min-height: 0;
    overflow: auto;
    padding: 8px 0 30px;
    scrollbar-color: #303030 #000;
    scrollbar-width: thin;
  }

  .bench-row {
    min-height: 18px;
    display: grid;
    grid-template-columns: 55px 110px 180px minmax(0, 1fr);
    align-items: baseline;
    padding-right: 12px;
    white-space: pre;
  }

  .bench-row:hover {
    background: #020e02;
  }

  .bench-line {
    padding-right: 10px;
    color: #3f3f3f;
    text-align: right;
    user-select: none;
  }

  .bench-level {
    color: #505050;
  }

  .bench-key {
    color: #00dddd;
  }

  .bench-value {
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bench-comment {
    min-height: 18px;
    padding: 2px 12px 2px 140px;
    color: #555;
    white-space: pre-wrap;
  }

  .bench-section {
    color: #00d400;
  }

  .bench-ok {
    color: #00d400;
  }

  .bench-info {
    color: #00dddd;
  }

  .bench-warn {
    color: #ffe600;
  }

  .bench-error {
    color: #ff2222;
  }

  .bench-magenta {
    color: #ff5fff;
  }

  .bench-white {
    color: #fff;
  }

  .bench-gray {
    color: #606060;
  }

  .history-header {
    padding-left: 12px;
    color: #ff5fff;
  }

  .history-row {
    min-height: 18px;
    display: grid;
    grid-template-columns:
      55px
      80px
      90px
      90px
      100px
      100px
      100px
      100px
      100px
      minmax(0, 1fr);
    padding-right: 10px;
    white-space: pre;
  }

  .history-cell {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .history-cell.header {
    color: #606060;
  }

  .bench-footer {
    min-height: 38px;
    padding: 6px 10px;
    border-top: 1px solid #303030;
    background: #050505;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    overflow: hidden;
    font-size: 11px;
  }

  .bench-footer > div {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
  }

  .cyan {
    color: #00dddd;
  }

  .green {
    color: #00d400;
  }

  .white {
    color: #fff;
  }

  .gray {
    color: #606060;
  }

  .red {
    color: #ff2222;
  }

  .yellow {
    color: #ffe600;
  }

  .magenta {
    color: #ff5fff;
  }

  @media (max-width: 900px) {
    .bench-row {
      grid-template-columns: 45px 95px 150px minmax(0, 1fr);
    }

    .bench-header {
      font-size: 11px;
    }

    .history-row {
      grid-template-columns:
        45px
        70px
        80px
        80px
        85px
        90px
        90px
        90px
        90px
        minmax(0, 1fr);
      font-size: 10px;
    }
  }

  @media (max-width: 640px) {
    .bench-command {
      grid-template-columns: 1fr auto;
    }

    .command-prefix {
      grid-column: 1 / -1;
    }

    .bench-command-input {
      grid-column: 1;
    }

    .bench-command-button {
      grid-column: 2;
    }

    .bench-row {
      grid-template-columns: 42px 84px 125px minmax(0, 1fr);
      font-size: 10px;
    }

    .bench-comment {
      padding-left: 78px;
      font-size: 10px;
    }

    .bench-footer > div:last-child {
      display: none;
    }
  }
</style>

<script>
  type AnyRecord = Record<string, unknown>;

  type BenchmarkState = {
    mode: string;
    state: string;
    status: string;

    gpuAvailable: boolean;
    gpuAdapter: string;
    gpuDevice: string;
    gpuError: string;

    width: number;
    height: number;
    samples: number;
    bounces: number;
    frame: number;

    frameTime: number;
    fps: number;
    elapsed: number;

    aiBackend: string;
    aiVersion: string;
    sensors: number;
    observationSize: number;
    actions: number;
    parameters: number;

    seed: number;
    step: number;
    episode: number;
    maxEpisodeSteps: number;

    reward: number;
    episodeReward: number;
    loss: number;
    epsilon: number;
    learningRate: number;
    gamma: number;
    replaySize: number;
    trainingSteps: number;
    trainCompleted: number;
    trainRequested: number;

    success: number;
    collision: number;
    done: number;

    difficulty: number;
    obstacles: number;

    raysPerFrame: number;
    raysPerSecond: number;
    samplesPerSecond: number;

    uniformBytes: number;
    framebufferBytes: number;

    timestamp: number;
  };

  type HistoryPoint = {
    episode: number;
    step: number;
    reward: number;
    loss: number;
    epsilon: number;
    replay: number;
    success: number;
    collision: number;
    fps: number;
  };

  const initialState: BenchmarkState = {
    mode: "READY",
    state: "IDLE",
    status: "READY",

    gpuAvailable: false,
    gpuAdapter: "UNKNOWN",
    gpuDevice: "UNKNOWN",
    gpuError: "",

    width: 0,
    height: 0,
    samples: 0,
    bounces: 0,
    frame: 0,

    frameTime: 0,
    fps: 0,
    elapsed: 0,

    aiBackend: "UNKNOWN",
    aiVersion: "UNKNOWN",
    sensors: 0,
    observationSize: 0,
    actions: 0,
    parameters: 0,

    seed: 0,
    step: 0,
    episode: 0,
    maxEpisodeSteps: 0,

    reward: 0,
    episodeReward: 0,
    loss: 0,
    epsilon: 1,
    learningRate: 0.0005,
    gamma: 0.99,
    replaySize: 0,
    trainingSteps: 0,
    trainCompleted: 0,
    trainRequested: 0,

    success: 0,
    collision: 0,
    done: 0,

    difficulty: 0,
    obstacles: 0,

    raysPerFrame: 0,
    raysPerSecond: 0,
    samplesPerSecond: 0,

    uniformBytes: 0,
    framebufferBytes: 0,

    timestamp: 0,
  };

  const telemetry: BenchmarkState = {
    ...initialState,
  };

  const episodeHistory: HistoryPoint[] = [];

  const MAX_HISTORY = 64;

  let benchmarkOpen = false;
  let benchmarkRunning = false;
  let historyEnabled = true;
  let lastHistoryEpisode = -1;

  const section = document.getElementById("benchmark");
  const benchScreen = document.getElementById("bench-screen");
  const commandInput = document.getElementById(
    "bench-command-input",
  ) as HTMLInputElement | null;
  const commandButton = document.getElementById(
    "bench-command-submit",
  ) as HTMLButtonElement | null;

  const modeElement = document.getElementById("bench-mode");
  const stateElement = document.getElementById("bench-state");

  const footerLeft = document.getElementById("bench-footer-left");
  const footerRight = document.getElementById("bench-footer-right");

  if (
    !section ||
    !benchScreen ||
    !commandInput ||
    !commandButton ||
    !modeElement ||
    !stateElement ||
    !footerLeft ||
    !footerRight
  ) {
    throw new Error("RAYTRC.BENCH DOM initialization failed");
  }

  function clone<T>(value: T): T {
    return JSON.parse(JSON.stringify(value));
  }

  function upper(value: unknown): string {
    return String(value ?? "")
      .trim()
      .toUpperCase();
  }

  function finite(
    value: unknown,
    fallback = 0,
  ): number {
    const n =
      typeof value === "number"
        ? value
        : Number(value);

    return Number.isFinite(n) ? n : fallback;
  }

  function bool(
    value: unknown,
    fallback = false,
  ): boolean {
    if (typeof value === "boolean") {
      return value;
    }

    if (value === "true" || value === 1 || value === "1") {
      return true;
    }

    if (value === "false" || value === 0 || value === "0") {
      return false;
    }

    return fallback;
  }

  function integer(
    value: unknown,
    fallback = 0,
  ): number {
    return Math.floor(finite(value, fallback));
  }

  function fixed(
    value: unknown,
    digits = 3,
  ): string {
    return finite(value).toFixed(digits);
  }

  function pad(
    value: unknown,
    width: number,
  ): string {
    return String(integer(value))
      .padStart(width, "0");
  }

  function percent(value: unknown): string {
    return `${(finite(value) * 100).toFixed(2)}%`;
  }

  function compactNumber(value: unknown): string {
    const n = finite(value);

    if (Math.abs(n) >= 1_000_000_000) {
      return `${(n / 1_000_000_000).toFixed(2)}G`;
    }

    if (Math.abs(n) >= 1_000_000) {
      return `${(n / 1_000_000).toFixed(2)}M`;
    }

    if (Math.abs(n) >= 1_000) {
      return `${(n / 1_000).toFixed(2)}K`;
    }

    return String(Math.floor(n));
  }

  function formatBytes(value: unknown): string {
    const n = finite(value);

    if (n >= 1024 * 1024 * 1024) {
      return `${(n / (1024 * 1024 * 1024)).toFixed(2)} GB`;
    }

    if (n >= 1024 * 1024) {
      return `${(n / (1024 * 1024)).toFixed(2)} MB`;
    }

    if (n >= 1024) {
      return `${(n / 1024).toFixed(2)} KB`;
    }

    return `${Math.floor(n)} B`;
  }

  function setMode(mode: string): void {
    telemetry.mode = mode;
    modeElement!.textContent = `MODE ===> ${mode}`;
  }

  function setState(value: string): void {
    telemetry.state = value;
    stateElement!.textContent = `STATE ===> ${value}`;
  }

  function dispatch(
    eventName: string,
    detail: AnyRecord = {},
  ): void {
    window.dispatchEvent(
      new CustomEvent(eventName, {
        detail,
      }),
    );
  }

  function resetTelemetry(): void {
    Object.assign(
      telemetry,
      clone(initialState),
    );

    episodeHistory.length = 0;
    lastHistoryEpisode = -1;

    renderTelemetry();
  }

  function clearScreen(): void {
    benchScreen!.innerHTML = "";
  }

  function addComment(
    text: string,
  ): void {
    const row = document.createElement("div");
    row.className = "bench-comment";
    row.textContent = text;
    benchScreen!.appendChild(row);
  }

  function addSection(
    text: string,
  ): void {
    const row = document.createElement("div");
    row.className = "bench-comment bench-section";
    row.textContent = text;
    benchScreen!.appendChild(row);
  }

  function addRow(
    lineNumber: number,
    key: string,
    value: string,
    tone = "normal",
  ): void {
    const row = document.createElement("div");
    row.className = "bench-row";

    const toneClass =
      tone === "ok"
        ? "bench-ok"
        : tone === "info"
          ? "bench-info"
          : tone === "warn"
            ? "bench-warn"
            : tone === "error"
              ? "bench-error"
              : tone === "magenta"
                ? "bench-magenta"
                : "bench-white";

    row.innerHTML = `
      <span class="bench-line">${pad(lineNumber, 4)}</span>
      <span class="bench-level">10</span>
      <span class="bench-key">${key}</span>
      <span class="bench-value ${toneClass}">${value}</span>
    `;

    benchScreen!.appendChild(row);
  }

  function addHistoryCell(
    row: HTMLElement,
    value: string,
    extraClass = "",
  ): void {
    const cell = document.createElement("span");
    cell.className = `history-cell ${extraClass}`;
    cell.textContent = value;
    row.appendChild(cell);
  }

  function addHistory(): void {
    if (!historyEnabled) {
      return;
    }

    const episode = integer(telemetry.episode);

    if (episode === lastHistoryEpisode) {
      return;
    }

    lastHistoryEpisode = episode;

    episodeHistory.push({
      episode,
      step: integer(telemetry.step),
      reward: finite(telemetry.reward),
      loss: finite(telemetry.loss),
      epsilon: finite(telemetry.epsilon),
      replay: integer(telemetry.replaySize),
      success: finite(telemetry.success),
      collision: finite(telemetry.collision),
      fps: finite(telemetry.fps),
    });

    if (episodeHistory.length > MAX_HISTORY) {
      episodeHistory.shift();
    }
  }

  function renderHistory(
    startLine: number,
  ): number {
    let line = startLine;

    addComment("------------------------------------------------------------");

    const header = document.createElement("div");
    header.className = "history-row";

    addHistoryCell(header, "LINE", "header");
    addHistoryCell(header, "EPISODE", "header");
    addHistoryCell(header, "STEP", "header");
    addHistoryCell(header, "REWARD", "header");
    addHistoryCell(header, "LOSS", "header");
    addHistoryCell(header, "EPS", "header");
    addHistoryCell(header, "REPLAY", "header");
    addHistoryCell(header, "SUCCESS", "header");
    addHistoryCell(header, "COLLISION", "header");
    addHistoryCell(header, "FPS", "header");

    benchScreen!.appendChild(header);

    for (let index = episodeHistory.length - 1; index >= 0; index -= 1) {
      const item = episodeHistory[index];

      const row = document.createElement("div");
      row.className = "history-row";

      addHistoryCell(row, pad(line, 4));
      addHistoryCell(row, pad(item.episode, 7));
      addHistoryCell(row, pad(item.step, 7));
      addHistoryCell(row, fixed(item.reward, 4));
      addHistoryCell(row, fixed(item.loss, 6));
      addHistoryCell(row, fixed(item.epsilon, 4));
      addHistoryCell(row, compactNumber(item.replay));
      addHistoryCell(row, percent(item.success));
      addHistoryCell(row, percent(item.collision));
      addHistoryCell(row, fixed(item.fps, 1));

      benchScreen!.appendChild(row);

      line += 1;
    }

    return line;
  }

  function renderTelemetry(): void {
    clearScreen();

    addSection("01 GENERAL");
    addRow(10, "MODE", telemetry.mode);
    addRow(20, "STATE", telemetry.state);
    addRow(30, "STATUS", telemetry.status);
    addRow(
      40,
      "TIMESTAMP",
      telemetry.timestamp
        ? new Date(telemetry.timestamp).toISOString()
        : "N/A",
    );

    addSection("02 GPU / RENDER");
    addRow(
      50,
      "GPU-AVAILABLE",
      telemetry.gpuAvailable ? "AVAILABLE" : "UNAVAILABLE",
      telemetry.gpuAvailable ? "ok" : "warn",
    );
    addRow(60, "GPU-ADAPTER", telemetry.gpuAdapter);
    addRow(70, "GPU-DEVICE", telemetry.gpuDevice);

    if (telemetry.gpuError) {
      addRow(
        80,
        "GPU-ERROR",
        telemetry.gpuError,
        "error",
      );
    }

    addRow(
      90,
      "RESOLUTION",
      `${integer(telemetry.width)} X ${integer(telemetry.height)}`,
    );
    addRow(100, "SAMPLES", pad(telemetry.samples, 6));
    addRow(110, "BOUNCES", pad(telemetry.bounces, 4));
    addRow(120, "FRAME", pad(telemetry.frame, 9));
    addRow(130, "FRAME-TIME", `${fixed(telemetry.frameTime, 3)} MS`);
    addRow(140, "FPS", fixed(telemetry.fps, 2));
    addRow(150, "ELAPSED", `${fixed(telemetry.elapsed, 2)} SEC`);

    addSection("03 AI ENGINE");
    addRow(160, "AI-BACKEND", telemetry.aiBackend);
    addRow(170, "AI-VERSION", telemetry.aiVersion);
    addRow(180, "SENSORS", pad(telemetry.sensors, 3));
    addRow(190, "OBSERVATION-SIZE", pad(telemetry.observationSize, 3));
    addRow(200, "ACTION-COUNT", pad(telemetry.actions, 2));
    addRow(
      210,
      "MODEL-PARAMETERS",
      compactNumber(telemetry.parameters),
    );

    addSection("04 ENVIRONMENT");
    addRow(220, "SEED", pad(telemetry.seed, 10));
    addRow(230, "STEP", pad(telemetry.step, 8));
    addRow(240, "EPISODE", pad(telemetry.episode, 8));
    addRow(
      250,
      "MAX-STEPS",
      pad(telemetry.maxEpisodeSteps, 7),
    );
    addRow(
      260,
      "DIFFICULTY",
      pad(telemetry.difficulty, 2),
    );
    addRow(
      270,
      "OBSTACLES",
      pad(telemetry.obstacles, 3),
    );

    addSection("05 TRAINER");
    addRow(
      280,
      "REWARD",
      fixed(telemetry.reward, 6),
      telemetry.reward >= 0 ? "ok" : "warn",
    );
    addRow(
      290,
      "EPISODE-REWARD",
      fixed(telemetry.episodeReward, 6),
      telemetry.episodeReward >= 0 ? "ok" : "warn",
    );
    addRow(
      300,
      "LOSS",
      fixed(telemetry.loss, 8),
    );
    addRow(
      310,
      "EPSILON",
      fixed(telemetry.epsilon, 6),
    );
    addRow(
      320,
      "LEARNING-RATE",
      fixed(telemetry.learningRate, 7),
    );
    addRow(
      330,
      "GAMMA",
      fixed(telemetry.gamma, 6),
    );
    addRow(
      340,
      "REPLAY",
      compactNumber(telemetry.replaySize),
    );
    addRow(
      345,
      "TRAIN-STEPS",
      compactNumber(telemetry.trainingSteps),
    );
    addRow(
      347,
      "TRAIN-PROGRESS",
      telemetry.trainRequested > 0
        ? `${integer(telemetry.trainCompleted)}/${integer(telemetry.trainRequested)}`
        : "CONTINUOUS",
    );

    addSection("06 EPISODE RESULT");
    addRow(
      350,
      "SUCCESS",
      percent(telemetry.success),
      telemetry.success > 0 ? "ok" : "info",
    );
    addRow(
      360,
      "COLLISION",
      percent(telemetry.collision),
      telemetry.collision > 0 ? "warn" : "ok",
    );
    addRow(
      370,
      "DONE",
      bool(telemetry.done) ? "YES" : "NO",
      bool(telemetry.done) ? "info" : "ok",
    );

    addSection("07 THROUGHPUT");
    addRow(
      380,
      "PRIMARY-RAYS / FRAME",
      compactNumber(telemetry.raysPerFrame),
    );
    addRow(
      390,
      "PRIMARY-RAYS / SEC",
      compactNumber(telemetry.raysPerSecond),
    );
    addRow(
      400,
      "SAMPLES / SEC",
      compactNumber(telemetry.samplesPerSecond),
    );

    addSection("08 MEMORY");
    addRow(
      410,
      "UNIFORM-BUFFER",
      formatBytes(telemetry.uniformBytes),
    );
    addRow(
      420,
      "FRAMEBUFFER",
      formatBytes(telemetry.framebufferBytes),
    );

    let nextLine = 430;

    if (historyEnabled) {
      addSection("09 EPISODE HISTORY");
      nextLine = renderHistory(nextLine);
    }

    addSection(`${String(10).padStart(2, "0")} COMMAND STATUS`);
    addRow(
      nextLine,
      "HISTORY",
      historyEnabled ? "ON" : "OFF",
    );

    footerLeft!.innerHTML = `
      <span class="gray">RAYTRC.BENCH</span>
      <span class="cyan">${telemetry.mode}</span>
      <span class="${telemetry.state === "ERROR" ? "red" : "green"}">
        ${telemetry.state}
      </span>
    `;

    footerRight!.innerHTML = `
      <span class="gray">COMMAND ===&gt;</span>
      <span class="white">HELP / STATUS / RUN / RESET / CLEAR / EXIT</span>
    `;

    benchScreen!.scrollTop = benchScreen!.scrollHeight;
  }

  function deriveThroughput(): void {
    const pixels =
      Math.max(
        0,
        integer(telemetry.width) *
          integer(telemetry.height),
      );

    telemetry.raysPerFrame = pixels;

    telemetry.raysPerSecond =
      pixels *
      Math.max(0, telemetry.fps);

    telemetry.samplesPerSecond =
      pixels *
      Math.max(0, integer(telemetry.samples)) *
      Math.max(0, telemetry.fps);
  }

  function mergeTelemetry(
    incoming: AnyRecord,
  ): void {
    if (!incoming || typeof incoming !== "object") {
      return;
    }

    if ("mode" in incoming) {
      telemetry.mode = String(incoming.mode);
    }

    if ("state" in incoming) {
      telemetry.state = String(incoming.state);
    }

    if ("status" in incoming) {
      telemetry.status = String(incoming.status);
    }

    if ("gpuAvailable" in incoming) {
      telemetry.gpuAvailable = bool(incoming.gpuAvailable);
    }

    if ("gpuAdapter" in incoming) {
      telemetry.gpuAdapter = String(incoming.gpuAdapter);
    }

    if ("gpuDevice" in incoming) {
      telemetry.gpuDevice = String(incoming.gpuDevice);
    }

    if ("gpuError" in incoming) {
      telemetry.gpuError = String(incoming.gpuError);
    }

    const numberFields: Array<keyof BenchmarkState> = [
      "width",
      "height",
      "samples",
      "bounces",
      "frame",
      "frameTime",
      "fps",
      "elapsed",
      "sensors",
      "observationSize",
      "actions",
      "parameters",
      "seed",
      "step",
      "episode",
      "maxEpisodeSteps",
      "reward",
      "episodeReward",
      "loss",
      "epsilon",
      "learningRate",
      "gamma",
      "replaySize",
      "trainingSteps",
      "trainCompleted",
      "trainRequested",
      "success",
      "collision",
      "done",
      "difficulty",
      "obstacles",
      "raysPerFrame",
      "raysPerSecond",
      "samplesPerSecond",
      "uniformBytes",
      "framebufferBytes",
      "timestamp",
    ];

    for (const field of numberFields) {
      if (field in incoming) {
        (
          telemetry[field] as unknown as number
        ) = finite(
          incoming[field],
          telemetry[field] as unknown as number,
        );
      }
    }

    const stringFields: Array<keyof BenchmarkState> = [
      "aiBackend",
      "aiVersion",
    ];

    for (const field of stringFields) {
      if (field in incoming) {
        (
          telemetry[field] as unknown as string
        ) = String(incoming[field]);
      }
    }

    deriveThroughput();
    addHistory();
    renderTelemetry();
  }

  function applyAIState(
    detail: AnyRecord,
  ): void {
    const stateObject =
      detail?.state &&
      typeof detail.state === "object"
        ? (detail.state as AnyRecord)
        : detail;

    mergeTelemetry({
      ...stateObject,
      ...(detail ?? {}),
    });
  }

  function applyGPUState(
    detail: AnyRecord,
  ): void {
    mergeTelemetry({
      gpuAvailable:
        detail?.available ??
        detail?.gpuAvailable ??
        telemetry.gpuAvailable,

      gpuAdapter:
        detail?.adapter ??
        detail?.gpuAdapter ??
        telemetry.gpuAdapter,

      gpuDevice:
        detail?.device ??
        detail?.gpuDevice ??
        telemetry.gpuDevice,

      gpuError:
        detail?.error ??
        detail?.gpuError ??
        telemetry.gpuError,

      width:
        detail?.renderWidth ??
        telemetry.width,

      height:
        detail?.renderHeight ??
        telemetry.height,

      uniformBytes:
        detail?.uniformBytes ??
        telemetry.uniformBytes,

      framebufferBytes:
        detail?.framebufferBytes ??
        detail?.accumulationBytes ??
        telemetry.framebufferBytes,
    });
  }

  function applyBenchmarkState(
    detail: AnyRecord,
  ): void {
    mergeTelemetry(detail);
  }

  function commandStatus(): void {
    setMode("STATUS");
    setState("QUERY");

    dispatch(
      "raytracer:benchmark-status-request",
      {
        source: "benchmark",
      },
    );

    renderTelemetry();
  }

  function requestRun(): void {
    benchmarkRunning = true;

    setMode("RUN");
    setState("RUNNING");

    /*
     * RUN has exactly one control path.
     * Renderer listens to raytracer:run directly; do not also emit
     * raytracer:ai RUN or one click becomes a double RUN request.
     */
    dispatch("raytracer:bench-run", {
      source: "benchmark",
    });

    dispatch("raytracer:run", {
      source: "benchmark",
    });

    renderTelemetry();
  }

  function requestStart(count = 0, mode: "steps" | "episodes" | "continuous" = "continuous"): void {
    benchmarkRunning = true;

    setMode(
      mode === "episodes"
        ? "TRAIN-EPISODES"
        : "TRAIN",
    );
    setState("RUNNING");

    const detail: AnyRecord = {
      source: "benchmark",
      count,
    };

    if (mode === "steps") {
      detail.action = "TRAIN_STEPS";
    } else if (mode === "episodes") {
      detail.action = "TRAIN_EPISODES";
    } else {
      detail.action = "START_TRAINING";
    }

    dispatch("raytracer:benchmark-start", {
      source: "benchmark",
      mode,
      count,
    });

    /* Exactly one AI event for training. */
    dispatch("raytracer:ai", detail);

    renderTelemetry();
  }

  function requestStop(): void {
    benchmarkRunning = false;

    setMode("STOP");
    setState("STOPPED");

    dispatch("raytracer:benchmark-stop", {
      source: "benchmark",
    });

    /* Renderer owns the STOP control path. */
    dispatch("raytracer:stop", {
      source: "benchmark",
    });

    renderTelemetry();
  }

  function executeCommand(
    input: string,
  ): boolean {
    const raw = input.trim();

    if (!raw) {
      return false;
    }

    const tokens =
      raw.match(/"[^"]*"|'[^']*'|\S+/g) ?? [];

    const command = upper(tokens[0]);
    const argument = upper(tokens[1]);

    if (
      command === "EXIT" ||
      command === "CLOSE"
    ) {
      benchmarkOpen = false;
      benchmarkRunning = false;

      section!.classList.remove(
        "benchmark-visible",
      );
      section!.setAttribute(
        "aria-hidden",
        "true",
      );

      dispatch(
        "raytracer:benchmark-close",
        {
          source: "benchmark",
        },
      );

      return true;
    }

    if (
      command === "HELP" ||
      command === "?"
    ) {
      showHelp();
      return true;
    }

    if (
      command === "RUN"
    ) {
      requestRun();
      return true;
    }

    if (
      command === "START"
    ) {
      requestStart();
      return true;
    }

    if (
      command === "TRAIN"
    ) {
      const count = Math.max(
        1,
        integer(tokens[1], 250),
      );

      requestStart(count, "steps");
      return true;
    }

    if (
      command === "EPISODES" ||
      command === "TRAIN-EPISODES"
    ) {
      const count = Math.max(
        1,
        integer(tokens[1], 1),
      );

      requestStart(count, "episodes");
      return true;
    }

    if (
      command === "STOP" ||
      command === "HALT"
    ) {
      requestStop();
      return true;
    }

    if (
      command === "STATUS"
    ) {
      commandStatus();
      return true;
    }

    if (
      command === "CLEAR" ||
      command === "CLS"
    ) {
      episodeHistory.length = 0;
      lastHistoryEpisode = -1;
      clearScreen();
      addComment(
        "SCREEN CLEARED / TELEMETRY BUFFER RETAINED",
      );
      return true;
    }

    if (
      command === "RESET"
    ) {
      episodeHistory.length = 0;
      lastHistoryEpisode = -1;

      dispatch("raytracer:benchmark-reset", {
        source: "benchmark",
      });

      dispatch("raytracer:ai", {
        action: "RESET_AI",
        source: "benchmark",
      });

      setMode("RESET");
      setState("IDLE");

      telemetry.episode = 0;
      telemetry.step = 0;
      telemetry.reward = 0;
      telemetry.episodeReward = 0;
      telemetry.loss = 0;
      telemetry.replaySize = 0;

      renderTelemetry();
      return true;
    }

    if (
      command === "HISTORY"
    ) {
      if (
        argument === "ON"
      ) {
        historyEnabled = true;
      } else if (
        argument === "OFF"
      ) {
        historyEnabled = false;
      } else {
        historyEnabled = !historyEnabled;
      }

      renderTelemetry();
      return true;
    }

    if (
      command === "EDIT"
    ) {
      dispatch("raytracer:controls-open", {
        source: "benchmark",
      });
      return true;
    }

    if (
      command === "EVAL"
    ) {
      const count = Math.max(
        1,
        integer(tokens[1], 10),
      );

      dispatch("raytracer:ai", {
        action: "EVALUATE",
        count,
        source: "benchmark",
      });

      setMode("EVAL");
      setState("RUNNING");

      renderTelemetry();
      return true;
    }

    if (
      command === "SAVE" ||
      command === "LOAD" ||
      command === "EXPORT" ||
      command === "IMPORT"
    ) {
      const target = upper(tokens[1]);

      if (target === "MODEL" || target === "CHECKPOINT") {
        const actionMap: Record<string, string> = {
          SAVE: "SAVE_MODEL",
          LOAD: "LOAD_MODEL",
          EXPORT: "EXPORT_MODEL",
          IMPORT: "IMPORT_MODEL",
        };

        dispatch("raytracer:ai", {
          action: actionMap[command],
          source: "benchmark",
        });

        setMode(`MODEL-${command}`);
        setState("RUNNING");
        renderTelemetry();
        return true;
      }
    }

    if (
      command === "STEP"
    ) {
      dispatch("raytracer:ai", {
        action: "STEP",
        source: "benchmark",
      });

      setMode("STEP");
      setState("RUNNING");

      renderTelemetry();
      return true;
    }

    if (
      command === "AI"
    ) {
      const action = upper(tokens[1]);

      dispatch("raytracer:ai", {
        action:
          action || "STATUS",
        source: "benchmark",
        count: Math.max(
          1,
          integer(tokens[2], 1),
        ),
      });

      setMode("AI");
      renderTelemetry();
      return true;
    }

    addComment(
      `INVALID COMMAND ===> ${raw}`,
    );

    return false;
  }

  function showHelp(): void {
    clearScreen();

    addSection("RAYTRC.BENCH COMMAND MEMBER");

    addRow(
      10,
      "RUN",
      "START RENDER + AI EXECUTION",
    );
    addRow(
      20,
      "START",
      "START AI TRAINING",
    );
    addRow(
      30,
      "STOP",
      "STOP ACTIVE EXECUTION",
    );
    addRow(
      40,
      "STATUS",
      "SHOW TELEMETRY",
    );
    addRow(
      50,
      "STEP",
      "RUN ONE AI STEP",
    );
    addRow(
      60,
      "EVAL N",
      "EVALUATE N EPISODES",
    );
    addRow(
      70,
      "RESET",
      "RESET BENCH + AI REQUEST",
    );
    addRow(
      80,
      "CLEAR",
      "CLEAR TELEMETRY SCREEN",
    );
    addRow(
      90,
      "HISTORY ON|OFF",
      "ENABLE / DISABLE EPISODE HISTORY",
    );
    addRow(
      100,
      "EDIT",
      "OPEN CONTROL MEMBER",
    );
    addRow(
      110,
      "EXIT",
      "CLOSE BENCHMARK MEMBER",
    );

    addSection("METRICS");

    addRow(
      180,
      "GPU",
      "ADAPTER / DEVICE / FRAME-TIME / FPS",
    );
    addRow(
      190,
      "AI",
      "SENSORS / MODEL / PARAMETER COUNT",
    );
    addRow(
      200,
      "ENV",
      "SEED / EPISODE / STEP / OBSTACLES",
    );
    addRow(
      210,
      "TRAIN",
      "REWARD / LOSS / EPSILON / REPLAY / TRAIN STEPS",
    );
    addRow(
      220,
      "RESULT",
      "SUCCESS / COLLISION / DONE",
    );
    addRow(
      230,
      "THROUGHPUT",
      "PRIMARY RAYS / SEC / SAMPLES / SEC",
    );

    addComment(
      "------------------------------------------------------------",
    );

    addComment(
      "EXAMPLE ===> TRAIN",
    );

    addComment(
      "EXAMPLE ===> EVAL 20",
    );

    addComment(
      "EXAMPLE ===> HISTORY OFF",
    );

    addComment(
      "EXAMPLE ===> EDIT",
    );
  }

  commandButton.addEventListener(
    "click",
    () => {
      const value =
        commandInput.value.trim();

      if (!value) {
        commandInput.focus();
        return;
      }

      executeCommand(value);
      commandInput.value = "";
      commandInput.focus();
    },
  );

  const commandHistory: string[] = [];
  let historyIndex = -1;

  commandInput.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Enter"
      ) {
        event.preventDefault();
        const command = commandInput.value.trim();
        if (command) {
          commandHistory.unshift(command);
          if (commandHistory.length > 100) {
            commandHistory.length = 100;
          }
        }
        historyIndex = -1;
        commandButton.click();
        return;
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        if (!commandHistory.length) return;
        historyIndex = Math.min(
          historyIndex + 1,
          commandHistory.length - 1,
        );
        commandInput.value = commandHistory[historyIndex] ?? "";
        commandInput.setSelectionRange(
          commandInput.value.length,
          commandInput.value.length,
        );
        return;
      }

      if (event.key === "ArrowDown") {
        event.preventDefault();
        if (!commandHistory.length) return;
        historyIndex = Math.max(
          historyIndex - 1,
          -1,
        );
        commandInput.value =
          historyIndex === -1
            ? ""
            : commandHistory[historyIndex] ?? "";
        commandInput.setSelectionRange(
          commandInput.value.length,
          commandInput.value.length,
        );
      }
    },
  );

  window.addEventListener(
    "raytracer:benchmark",
    (event) => {
      applyBenchmarkState(
        (event as CustomEvent<AnyRecord>).detail ?? {},
      );
    },
  );

  window.addEventListener(
    "raytracer:gpu",
    (event) => {
      applyGPUState(
        (event as CustomEvent<AnyRecord>).detail ?? {},
      );
    },
  );

  window.addEventListener(
    "raytracer:ai-state",
    (event) => {
      applyAIState(
        (event as CustomEvent<AnyRecord>).detail ?? {},
      );
    },
  );

  window.addEventListener(
    "raytracer:ai-metrics",
    (event) => {
      applyAIState(
        (event as CustomEvent<AnyRecord>).detail ?? {},
      );
    },
  );

  window.addEventListener(
    "raytracer:benchmark-open",
    () => {
      benchmarkOpen = true;

      section!.classList.add(
        "benchmark-visible",
      );

      section!.setAttribute(
        "aria-hidden",
        "false",
      );

      setMode("OPEN");
      setState("IDLE");

      renderTelemetry();

      requestAnimationFrame(
        () => commandInput.focus(),
      );
    },
  );

  window.addEventListener(
    "raytracer:benchmark-close",
    () => {
      benchmarkOpen = false;
      benchmarkRunning = false;

      section!.classList.remove(
        "benchmark-visible",
      );

      section!.setAttribute(
        "aria-hidden",
        "true",
      );
    },
  );

  window.addEventListener(
    "raytracer:benchmark-opened",
    () => {
      benchmarkOpen = true;

      section!.classList.add(
        "benchmark-visible",
      );

      section!.setAttribute(
        "aria-hidden",
        "false",
      );

      renderTelemetry();
    },
  );

  window.addEventListener(
    "raytracer:training-start",
    () => {
      benchmarkRunning = true;
      setMode("TRAIN");
      setState("RUNNING");
      renderTelemetry();
    },
  );

  window.addEventListener(
    "raytracer:training-stop",
    () => {
      benchmarkRunning = false;
      setMode("STOP");
      setState("STOPPED");
      renderTelemetry();
    },
  );

  window.addEventListener(
    "raytracer:training-complete",
    () => {
      benchmarkRunning = false;
      setMode("TRAIN");
      setState("COMPLETE");
      renderTelemetry();
    },
  );

  window.addEventListener(
    "raytracer:training-progress",
    (event) => {
      const detail =
        (event as CustomEvent<AnyRecord>).detail ?? {};

      mergeTelemetry({
        ...detail,
        state: "RUNNING",
        status:
          detail.status ??
          (detail.requested
            ? `TRAINING ${integer(detail.completed)}/${integer(detail.requested)}`
            : `TRAINING ${integer(detail.completed)}`),
        trainCompleted:
          detail.completed ??
          telemetry.trainCompleted,
        trainRequested:
          detail.requested ??
          telemetry.trainRequested,
        trainingSteps:
          detail.trainingSteps ??
          telemetry.trainingSteps,
      });

      benchmarkRunning = true;
      setMode("TRAIN");
      setState("RUNNING");
    },
  );

  window.addEventListener(
    "raytracer:ai-episode",
    (event) => {
      const detail =
        (event as CustomEvent<AnyRecord>).detail ?? {};

      mergeTelemetry({
        episode: detail.episode ?? telemetry.episode,
        reward: detail.reward ?? telemetry.reward,
        success: detail.success ?? telemetry.success,
        collision: detail.collision ?? telemetry.collision,
        done: 1,
      });
    },
  );

  window.addEventListener(
    "raytracer:renderer-ready",
    (event) => {
      const detail =
        (event as CustomEvent<AnyRecord>).detail ?? {};

      mergeTelemetry({
        aiBackend: detail.backend ?? telemetry.aiBackend,
        aiVersion: detail.version ?? telemetry.aiVersion,
        timestamp: Date.now(),
      });
    },
  );

  window.addEventListener(
    "raytracer:ai-error",
    (event) => {
      const detail =
        (event as CustomEvent<AnyRecord>).detail ?? {};

      telemetry.status =
        String(
          detail.error ??
          detail.message ??
          "AI ERROR",
        );

      setMode("AI");
      setState("ERROR");

      renderTelemetry();
    },
  );

  window.addEventListener(
    "raytracer:frame",
    (event) => {
      const detail =
        (event as CustomEvent<AnyRecord>).detail ?? {};

      mergeTelemetry({
        frame:
          detail.frame ??
          telemetry.frame,

        frameTime:
          detail.frameTime ??
          telemetry.frameTime,

        fps:
          detail.fps ??
          telemetry.fps,

        elapsed:
          detail.elapsed ??
          telemetry.elapsed,

        width:
          detail.width ??
          telemetry.width,

        height:
          detail.height ??
          telemetry.height,

        samples:
          detail.samples ??
          telemetry.samples,

        bounces:
          detail.bounces ??
          telemetry.bounces,
      });
    },
  );

  const api = {
    open(): void {
      dispatch(
        "raytracer:benchmark-open",
        {
          source: "api",
        },
      );
    },

    close(): void {
      dispatch(
        "raytracer:benchmark-close",
        {
          source: "api",
        },
      );
    },

    clear(): void {
      episodeHistory.length = 0;
      lastHistoryEpisode = -1;
      renderTelemetry();
    },

    reset(): void {
      resetTelemetry();
    },

    run(): void {
      requestRun();
    },

    start(): void {
      requestStart();
    },

    stop(): void {
      requestStop();
    },

    command(command: string): boolean {
      return executeCommand(command);
    },

    getState(): BenchmarkState {
      return clone(telemetry);
    },

    getHistory(): HistoryPoint[] {
      return clone(episodeHistory);
    },

    update(detail: AnyRecord): void {
      mergeTelemetry(detail);
    },
  };

  (
    window as typeof window & {
      RayTracerBenchmark?: typeof api;
    }
  ).RayTracerBenchmark = api;

  telemetry.timestamp = Date.now();
  deriveThroughput();
  renderTelemetry();
</script>