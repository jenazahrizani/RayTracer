  function startTrainingSteps(
    count: number,
  ): void {
    startTrainingWorker(
      "steps",
      count,
    );
  }

  function startContinuousTraining(): void {
    startTrainingWorker(
      "continuous",
      0,
    );
  }

  function startEpisodeTraining(
    count: number,
  ): void {
    startTrainingWorker(
      "episodes",
      count,
    );
  }

  function stopTraining(
    emitEvent = true,
  ): void {
    const wasTraining =
      training;

    const wasEvaluation =
      evaluation;

    training =
      false;

    trainingPreview =
      false;

    evaluation =
      false;

    clearTrainingTimer();
    terminateTrainingWorker();

    if (
      wasTraining ||
      wasEvaluation ||
      emitEvent
    ) {
      emit(
        "raytracer:training-stop",
        {
          source:
            "renderer",
        },
      );
    }

    if (
      !destroyed &&
      (
        wasTraining ||
        wasEvaluation
      )
    ) {
      setMode(
        "STOP",
      );

      setState(
        "STOPPED",
      );

      snapshot.status =
        wasEvaluation
          ? "EVALUATION STOPPED"
          : "TRAINING STOPPED";

      setMessage(
        wasEvaluation
          ? "EVALUATION STOPPED"
          : "TRAINING STOPPED / PREVIEW PRESERVED",
      );

      renderRuntime();
      emitAIState();
    }
  }

  function runEvaluation(
    count: number,
  ): void {
    if (
      !engine
    ) {
      setMessage(
        "RUNTIME NOT READY",
      );
      return;
    }

    terminateTrainingWorker();
    clearTrainingTimer();

    training =
      false;

    runMode =
      false;

    evaluation =
      true;

    const requested =
      clampInt(
        count,
        1,
        10000,
      );

    const baseSeed =
      (
        snapshot.seed ||
        1
      ) + 100000;

    const model =
      engine.export_model();

    const jobId =
      ++trainingJobId;

    const worker =
      new Worker(
        new URL(
          "../workers/training.worker.ts",
          import.meta.url,
        ),
        {
          type: "module",
        },
      );

    trainingWorker =
      worker;

    worker.addEventListener(
      "message",
      handleTrainingWorkerMessage,
    );

    worker.addEventListener(
      "error",
      (event) => {
        if (
          jobId !==
          trainingJobId
        ) {
          return;
        }

        terminateTrainingWorker();

        evaluation =
          false;

        handleRuntimeError(
          event.error ??
            new Error(
              event.message ||
                "evaluation worker error",
            ),
        );
      },
    );

    setMode(
      "EVAL",
    );

    setState(
      "RUNNING",
    );

    snapshot.status =
      `EVALUATING ${requested}`;

    setMessage(
      `EVALUATING ${requested} / CPU WORKER`,
    );

    worker.postMessage(
      {
        type:
          "EVALUATE",

        jobId,

        requested,

        baseSeed,

        model,

        config:
          getTrainingConfig(),
      },
    );

    renderRuntime();
    emitAIState();
  }

  function resetAI(): void {
    if (!engine) {
      return;
    }

    stopTraining(
      false,
    );

    runMode =
      false;

    trainingPreview =
      false;

    evaluation =
      false;

    engine.reset_ai();

    setMode(
      "AI-RESET",
    );

    setState(
      "COMPLETE",
    );

    snapshot.status =
      "AI RESET COMPLETE";

    setMessage(
      "AI NETWORK + REPLAY RESET",
    );

    syncSnapshot();
  }

  function resetEnvironment(
    requestedSeed?: unknown,
  ): void {
    if (!engine) {
      return;
    }

    stopTraining(
      false,
    );

    runMode =
      false;

    trainingPreview =
      false;

    evaluation =
      false;

    const seed =
      requestedSeed ===
        undefined
        ? (
            Date.now() >>>
            0
          )
        : Math.max(
            0,
            integer(
              requestedSeed,
            ),
          );

    engine.reset_environment(
      seed,
    );

    setMode(
      "ENV-RESET",
    );

    setState(
      "COMPLETE",
    );

    snapshot.status =
      "ENVIRONMENT RESET";

    setMessage(
      `ENVIRONMENT RESET / SEED ${seed}`,
    );

    syncSnapshot();
  }

  function hardReset(): void {
    if (!engine) {
      return;
    }

    stopTraining(
      false,
    );

    runMode =
      false;

    trainingPreview =
      false;

    evaluation =
      false;

    engine.hard_reset();

    setMode(
      "HARD-RESET",
    );

    setState(
      "COMPLETE",
    );

    snapshot.status =
      "HARD RESET COMPLETE";

    setMessage(
      "AI + ENVIRONMENT HARD RESET",
    );

    syncSnapshot();
  }

  function executeAICommand(
    detail: Record<
      string,
      unknown
    >,
  ): void {
    if (
      !engine
    ) {
      setMessage(
        "RUNTIME NOT READY",
      );

      return;
    }

    const action =
      upper(
        detail.action,
      );

    const count =
      clampInt(
        detail.count,
        1,
        1000000,
      );

    switch (
      action
    ) {
      case "STATUS": {
        syncSnapshot();
        return;
      }

      case "STEP": {
        stopTraining(
          false,
        );

        runMode =
          false;

        evaluation =
          false;

        currentAction =
          clampInt(
            engine.predict_action(),
            0,
            4,
          );

        const result =
          safeBuffer(
            engine.step(
              currentAction,
            ),
          );

        const done =
          finite(
            result[1],
          ) > 0.5;

        setMode(
          "STEP",
        );

        setState(
          "COMPLETE",
        );

        snapshot.status =
          "AI STEP COMPLETE";

        setMessage(
          `AI STEP / ACTION ${
            ACTION_NAMES[
              currentAction
            ] ??
            currentAction
          }`,
        );

        if (done) {
          emit(
            "raytracer:ai-episode",
            {
              episode:
                finite(
                  engine.current_episode(),
                ),

              reward:
                finite(
                  result[0],
                ),

              success:
                finite(
                  result[2],
                ) > 0.5,

              collision:
                finite(
                  result[3],
                ) > 0.5,

              distance:
                finite(
                  result[4],
                ),

              action:
                currentAction,
            },
          );
        }

        syncSnapshot();

        return;
      }

      case "TRAIN_STEPS": {
        startTrainingSteps(
          count,
        );

        return;
      }

      case "TRAIN_EPISODES": {
        startEpisodeTraining(
          count,
        );

        return;
      }

      case "START_TRAINING": {
        startContinuousTraining();

        return;
      }

      case "EVALUATE": {
        runEvaluation(
          count,
        );

        return;
      }

      case "RESET_AI": {
        resetAI();

        return;
      }

      case "RESET_ENVIRONMENT": {
        resetEnvironment(
          detail.seed,
        );

        return;
      }

      case "HARD_RESET": {
        hardReset();

        return;
      }

      case "RUN": {
        // RUN controls only the foreground autonomous preview.
        // It must NEVER stop the background training worker.
        handleRun();
        return;
      }

      case "STOP": {
        stopTraining();

        runMode =
          false;

        evaluation =
          false;

        setMode(
          "STOP",
        );

        setState(
          "STOPPED",
        );

        snapshot.status =
          "RUNTIME STOPPED";

        setMessage(
          "RUNTIME STOPPED",
        );

        syncSnapshot();

        return;
      }

      case "SAVE_MODEL": {
        try {
          const data =
            engine.save_model();

          localStorage.setItem(
            "raytrc.ai.model",
            data,
          );

          snapshot.status =
            "MODEL SAVED";

          setMessage(
            "MODEL SAVED TO LOCAL STORAGE",
          );

          syncSnapshot();
        } catch (error) {
          handleRuntimeError(
            error,
          );
        }

        return;
      }

      case "LOAD_MODEL": {
        try {
          const data =
            localStorage.getItem(
              "raytrc.ai.model",
            );

          if (
            !data
          ) {
            setMessage(
              "NO SAVED MODEL FOUND",
            );

            return;
          }

          const loaded =
            engine.load_model(
              data,
            );

          snapshot.status =
            loaded
              ? "MODEL LOADED"
              : "MODEL LOAD REJECTED";

          setMessage(
            loaded
              ? "MODEL LOADED"
              : "MODEL LOAD REJECTED",
          );

          syncSnapshot();
        } catch (error) {
          handleRuntimeError(
            error,
          );
        }

        return;
      }

      case "EXPORT_MODEL": {
        try {
          const data =
            engine.export_model();

          downloadText(
            data,
            "raytrc-ai-model.txt",
          );

          snapshot.status =
            "MODEL EXPORTED";

          setMessage(
            "MODEL EXPORTED",
          );
        } catch (error) {
          handleRuntimeError(
            error,
          );
        }

        return;
      }

      case "IMPORT_MODEL": {
        openModelFilePicker();

        return;
      }

      default:
        setMessage(
          `UNKNOWN AI ACTION: ${action}`,
        );
    }
  }

  function openModelFilePicker(): void {
    if (!engine) {
      return;
    }

    const input =
      document.createElement(
        "input",
      );

    input.type =
      "file";

    input.accept =
      ".txt,.json,.model,text/plain,application/json";

    input.addEventListener(
      "change",
      async () => {
        const file =
          input.files?.[0];

        if (
          !file ||
          !engine
        ) {
          return;
        }

        try {
          const data =
            await file.text();

          const imported =
            engine.import_model(
              data,
            );

          snapshot.status =
            imported
              ? "MODEL IMPORTED"
              : "MODEL IMPORT REJECTED";

          setMessage(
            imported
              ? "MODEL IMPORTED"
              : "MODEL IMPORT REJECTED",
          );

          syncSnapshot();
        } catch (error) {
          handleRuntimeError(
            error,
          );
        }
      },
    );

    input.click();
  }

  function downloadText(
    text: string,
    filename: string,
  ): void {
    const blob =
      new Blob(
        [text],
        {
          type:
            "text/plain;charset=utf-8",
        },
      );

    const url =
      URL.createObjectURL(
        blob,
      );

    const anchor =
      document.createElement(
        "a",
      );

    anchor.href =
      url;

    anchor.download =
      filename;

    document.body.appendChild(
      anchor,
    );

    anchor.click();

    anchor.remove();

    window.setTimeout(
      () => {
        URL.revokeObjectURL(
          url,
        );
      },
      1000,
    );
  }

  function handleRuntimeError(
    error: unknown,
  ): void {
    const message =
      error instanceof Error
        ? error.message
        : String(
            error,
          );

    snapshot.mode =
      "ERROR";

    snapshot.state =
      "ERROR";

    snapshot.status =
      message;

    setMode(
      "ERROR",
    );

    setState(
      "ERROR",
    );

    setMessage(
      message,
    );

    renderRuntime();

    emit(
      "raytracer:ai-error",
      {
        error:
          message,
      },
    );
  }

  /*
   * IMPORTANT:
   *
   * Do not write:
   *
   *   import(WASM_JS_URL)
   *
   * here.
   *
   * The generated wasm-bindgen glue is inside public/wasm.
   * Vite must not add it to the source module graph.
   *
   * Native import() is invoked indirectly through Function()
   * so the browser resolves the final absolute URL itself.
   */
  async function importPublicWasmModule(
    url: string,
  ): Promise<WasmModule> {
    const nativeImport =
      new Function(
        "url",
        "return import(url);",
      ) as (
        url: string,
      ) => Promise<WasmModule>;

    return nativeImport(
      url,
    );
  }

  async function loadWasm(): Promise<void> {
    if (
      wasmReady
    ) {
      return;
    }

    setMode(
      "WASM-LOAD",
    );

    setState(
      "LOADING",
    );

    snapshot.status =
      "LOADING WASM";

    setMessage(
      "LOADING RUST WASM ENGINE",
    );

    try {
      /*
       * Verify that the public static file really exists.
       * This gives a much better runtime error than a module
       * resolution error.
       */
      const response =
        await fetch(
          WASM_JS_URL,
          {
            cache:
              "no-store",
          },
        );

      if (
        !response.ok
      ) {
        throw new Error(
          `WASM JS HTTP ${response.status}: ${WASM_JS_URL}`,
        );
      }

      const contentType =
        (
          response.headers.get(
            "content-type",
          ) || ""
        ).toLowerCase();

      if (
        contentType.includes(
          "text/html",
        )
      ) {
        throw new Error(
          `WASM JS URL returned HTML instead of JavaScript: ${WASM_JS_URL}`,
        );
      }

      /*
       * Native browser module import.
       */
      const imported =
        await importPublicWasmModule(
          WASM_JS_URL,
        );

      wasmModule =
        imported;

      if (
        typeof imported.default !==
          "function"
      ) {
        throw new Error(
          "WASM GLUE INVALID: DEFAULT INITIALIZER NOT FOUND",
        );
      }

      if (
        typeof imported.RayTracerEngine !==
          "function"
      ) {
        throw new Error(
          "WASM GLUE INVALID: RayTracerEngine NOT FOUND",
        );
      }

      await imported.default();

      engine =
        new imported.RayTracerEngine();

      wasmReady =
        true;

      initialized =
        true;

      snapshot.backend =
        engine.backend();

      snapshot.version =
        engine.version();

      snapshot.sensorCount =
        engine.sensor_count();

      snapshot.observationSize =
        engine.observation_size();

      snapshot.actionCount =
        engine.action_count();

      snapshot.parameterCount =
        engine.model_parameter_count();

      snapshot.status =
        "WASM READY";

      setMode(
        "READY",
      );

      setState(
        "IDLE",
      );

      setMessage(
        "RUST WASM ENGINE READY",
      );

      applyControls(
        controlsState,
      );

      await initWebGPU();
      resizeCanvas();
      syncSnapshot();

      emit(
        "raytracer:gpu",
        {
          available:
            gpuReady,

          adapter:
            gpuReady
              ? "WEBGPU / HIGH-PERFORMANCE"
              : "CANVAS2D FALLBACK",

          device:
            gpuReady
              ? "WEBGPU DEVICE READY"
              : "NO WEBGPU DEVICE",

          uniformBytes:
            gpuReady
              ? 32
              : 0,

          framebufferBytes:
            gpuReady && gpuCanvas
              ? gpuCanvas.width *
                gpuCanvas.height *
                4
              : canvas!.width *
                canvas!.height *
                4,
        },
      );

      emit(
        "raytracer:renderer-ready",
        {
          backend:
            snapshot.backend,

          version:
            snapshot.version,
        },
      );
    } catch (error) {
      wasmReady =
        false;

      initialized =
        false;

      engine =
        null;

      const reason =
        error instanceof Error
          ? error.message
          : String(
              error,
            );

      handleRuntimeError(
        new Error(
          `WASM LOAD FAILED: ${reason}`,
        ),
      );
    }
  }

  function handleControls(
    event: Event,
  ): void {
    const detail =
      (
        event as CustomEvent<{
          state?:
            Partial<ControlsState>;
        }>
      ).detail;

    if (
      detail?.state
    ) {
      applyControls(
        detail.state,
      );
    }
  }

  function handleControlsReset(): void {
    controlsState = {
      ...controlsState,

      difficulty:
        3,

      obstacles:
        12,

      episodeSteps:
        1000,

      learningRate:
        0.0005,

      gamma:
        0.99,

      batchSize:
        64,

      epsilon:
        1,

      epsilonMin:
        0.05,

      epsilonDecay:
        0.9975,

      targetUpdate:
        250,

      trainChunk:
        250,
    };

    if (
      engine
    ) {
      applyControls(
        controlsState,
      );
    }
  }

  function handleRun(): void {
    if (
      !engine
    ) {
      setMessage(
        "RUNTIME NOT READY",
      );
      return;
    }

    if (evaluation) {
      terminateTrainingWorker();
      clearTrainingTimer();
      evaluation = false;
    }

    trainingPreview =
      false;

    recoveryMoveFrames =
      0;

    /*
     * RUN can also be pressed after a terminal state, but normal
     * successful navigation already rotates to a new map automatically.
     */
    if (
      engine.is_done()
    ) {
      const nextSeed =
        Date.now() >>> 0;

      engine.reset_environment(
        nextSeed,
      );
    }

    currentAction =
      0;

    runStallFrames =
      0;

    runLastDistance = Number.POSITIVE_INFINITY;

    lastInferenceTime =
      0;

    syncWorldBuffers();

    runMode =
      true;

    setMode(
      "RUN",
    );

    setState(
      "RUNNING",
    );

    snapshot.status =
      "AUTONOMOUS RUN";

    setMessage(
      "AUTONOMOUS NAVIGATION ACTIVE / 30 HZ",
    );

    syncSnapshot();
  }

  function handleStop(): void {
    stopTraining();

    runMode =
      false;

    trainingPreview =
      false;

    evaluation =
      false;

    setMode(
      "STOP",
    );

    setState(
      "STOPPED",
    );

    snapshot.status =
      "STOPPED";

    setMessage(
      "RUNTIME STOPPED",
    );

    syncSnapshot();
  }

  function handleRenderRequest(): void {
    drawWorld();

    setMode(
      "VIEW",
    );

    setState(
      "COMPLETE",
    );

    snapshot.status =
      "WORLD REFRESHED";

    setMessage(
      "WORLD VIEW REFRESHED",
    );

    syncSnapshot();
  }

  function handleView(): void {
    drawWorld();

    setMode(
      "VIEW",
    );

    setState(
      "IDLE",
    );

    snapshot.status =
      "VIEW REQUESTED";

    setMessage(
      "VIEW REQUEST RECEIVED",
    );

    renderRuntime();
  }

  function handleBenchmark(): void {
    emit(
      "raytracer:benchmark-open",
      {
        source:
          "renderer",
      },
    );
  }

  function handleExternalAI(
    event: Event,
  ): void {
    const detail =
      (
        event as CustomEvent<
          Record<
            string,
            unknown
          >
        >
      ).detail ?? {};

    executeAICommand(
      detail,
    );
  }

  window.addEventListener(
    "resize",
    resizeCanvas,
  );

  window.addEventListener(
    "raytracer:controls",
    handleControls,
  );

  /*
   * Controls emits controls-apply after APPLY.
   * We deliberately do NOT listen to both controls and
   * controls-apply with the same handler because that can
   * apply the same state twice.
   */
  window.addEventListener(
    "raytracer:controls-reset",
    handleControlsReset,
  );

  window.addEventListener(
    "raytracer:run",
    handleRun,
  );

  window.addEventListener(
    "raytracer:stop",
    handleStop,
  );

  window.addEventListener(
    "raytracer:render-request",
    handleRenderRequest,
  );

  window.addEventListener(
    "raytracer:view",
    handleView,
  );

  window.addEventListener(
    "raytracer:bench",
    handleBenchmark,
  );

  /*
   * IMPORTANT:
   * Only listen to raytracer:ai.
   *
   * Controls.astro also emits raytracer:ai-command for
   * compatibility. Listening to both would execute every
   * AI operation twice.
   */
  window.addEventListener(
    "raytracer:ai",
    handleExternalAI,
  );

  window.addEventListener(
    "raytracer:training-stop",
    () => {
      if (
        training
      ) {
        stopTraining(
          false,
        );
      }
    },
  );

  window.addEventListener(
    "beforeunload",
    () => {
      destroyed =
        true;

      training =
        false;

      evaluation =
        false;

      clearTrainingTimer();
      terminateTrainingWorker();

      if (
        frameHandle
      ) {
        cancelAnimationFrame(
          frameHandle,
        );
      }
    },
  );

  const api = {
    getEngine(): Engine | null {
      return engine;
    },

    isReady(): boolean {
      return (
        wasmReady &&
        !!engine
      );
    },

    getState(): RuntimeSnapshot {
      return {
        ...snapshot,
      };
    },

    getBuffers(): {
      sensors: number[];
      agent: number[];
      target: number[];
      obstacles: number[];
      path: number[];
    } {
      return {
        sensors: [
          ...sensorBuffer,
        ],

        agent: [
          ...agentBuffer,
        ],

        target: [
          ...targetBuffer,
        ],

        obstacles: [
          ...obstacleBuffer,
        ],

        path: [
          ...pathBuffer,
        ],
      };
    },

    run(): void {
      handleRun();
    },

    stop(): void {
      handleStop();
    },

    train(
      steps =
        controlsState.trainChunk,
    ): void {
      startTrainingSteps(
        steps,
      );
    },

    trainEpisodes(
      count = 1,
    ): void {
      startEpisodeTraining(
        count,
      );
    },

    evaluate(
      count = 10,
    ): void {
      runEvaluation(
        count,
      );
    },

    step(): void {
      executeAICommand(
        {
          action:
            "STEP",
        },
      );
    },

    resetAI(): void {
      executeAICommand(
        {
          action:
            "RESET_AI",
        },
      );
    },

    resetEnvironment(
      seed =
        Date.now() >>> 0,
    ): void {
      executeAICommand(
        {
          action:
            "RESET_ENVIRONMENT",

          seed,
        },
      );
    },

    hardReset(): void {
      executeAICommand(
        {
          action:
            "HARD_RESET",
        },
      );
    },

    saveModel(): void {
      executeAICommand(
        {
          action:
            "SAVE_MODEL",
        },
      );
    },

    loadModel(): void {
      executeAICommand(
        {
          action:
            "LOAD_MODEL",
        },
      );
    },

    exportModel(): void {
      executeAICommand(
        {
          action:
            "EXPORT_MODEL",
        },
      );
    },

    importModel(): void {
      executeAICommand(
        {
          action:
            "IMPORT_MODEL",
        },
      );
    },

    refresh(): void {
      syncSnapshot();
      drawWorld();
    },
  };

  (
    window as typeof window & {
      RayTracerRenderer?:
        typeof api;
    }
  ).RayTracerRenderer =
    api;

  resizeCanvas();

  renderRuntime();

  setMode(
    "WASM-LOAD",
  );

  setState(
    "LOADING",
  );

  setMessage(
    "LOADING RUST WASM ENGINE",
  );

  loadWasm().catch(
    handleRuntimeError,
  );

  frameHandle =
    requestAnimationFrame(
      animationFrame,
    );
</script>
