      loss:
        snapshot.loss,

      epsilon:
        snapshot.epsilon,

      learningRate:
        snapshot.learningRate,

      gamma:
        snapshot.gamma,

      replaySize:
        snapshot.replay,

      success:
        snapshot.success
          ? 1
          : 0,

      collision:
        snapshot.collision
          ? 1
          : 0,

      done:
        snapshot.done
          ? 1
          : 0,

      sensors:
        snapshot.sensorCount,

      observationSize:
