---
---

<section
  id="renderer"
  class="renderer"
>
  <canvas
    id="gpu-canvas"
    class="gpu-canvas"
    aria-label="RayTracer WebGPU background"
  ></canvas>

  <canvas
    id="world-canvas"
    class="world-canvas"
    aria-label="RayTracer AI navigation world"
  ></canvas>

  <!--
    Runtime telemetry is intentionally kept in the DOM but hidden.
    Main telemetry belongs to Benchmark.astro.
  -->
  <div
    class="terminal"
    aria-hidden="true"
  >
    <div class="terminal-head">
      <span class="cyan">RAYTRC.RUNTIME</span>
      <span class="gray">/</span>
      <span class="white">AI NAVIGATION ENGINE</span>
      <span class="gray">/</span>
      <span
        id="runtime-mode"
        class="green"
      >
        WAITING
      </span>
    </div>

    <div class="terminal-ruler">
      <span>0001</span>

      <span>
        +....1....+....2....+....3....+....4....+....5....+....6....+....7....+....8
      </span>

      <span>COLS&gt;</span>
    </div>

    <div
      id="runtime-screen"
      class="runtime-screen"
    ></div>
  </div>

  <div
    id="runtime-message"
    class="runtime-message"
  >
    <span class="gray">STATUS ===&gt;</span>

    <span id="runtime-message-text">
      INITIALIZING
    </span>
  </div>
</section>

<style>
  .renderer {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: #000;
    color: #d0d0d0;
    font-family:
      "IBM Plex Mono",
      "Courier New",
      Consolas,
      monospace;
  }

  .gpu-canvas,
  .world-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .gpu-canvas {
    z-index: 0;
    background: #000;
  }

  .world-canvas {
    z-index: 1;
    background: transparent;
    image-rendering: pixelated;
  }

  /*
   * Renderer telemetry is deliberately hidden.
   * The main source-editor belongs to index.astro.
   * Benchmark.astro owns the full telemetry screen.
   */
  .terminal {
    display: none;
  }

  .terminal-head {
    min-height: 28px;
    padding: 5px 9px;
    display: flex;
    align-items: center;
    gap: 7px;
    border-bottom: 1px solid #202020;
    background: #050505;
    white-space: nowrap;
    overflow: hidden;
    font-size: 11px;
  }

  .terminal-ruler {
    min-height: 18px;
    padding: 2px 9px;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: 8px;
    border-bottom: 1px solid #181818;
    color: #4f4f4f;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
  }

  .terminal-ruler span:nth-child(2) {
    overflow: hidden;
  }

  .runtime-screen {
    max-height: 46vh;
    overflow: auto;
    padding: 6px 0 24px;
    scrollbar-color: #303030 #000;
    scrollbar-width: thin;
  }

  .runtime-row {
    min-height: 17px;
    display: grid;
    grid-template-columns:
      48px
      70px
      145px
      minmax(0, 1fr);
    gap: 0;
    padding-right: 10px;
    white-space: pre;
    font-size: 11px;
  }

  .runtime-row:hover {
    background: #020e02;
  }

  .runtime-line {
    padding-right: 8px;
    text-align: right;
    color: #3e3e3e;
    user-select: none;
  }

  .runtime-level {
    color: #505050;
  }

  .runtime-key {
    color: #00dddd;
  }

  .runtime-value {
    overflow: hidden;
    text-overflow: ellipsis;
    color: #fff;
  }

  .runtime-comment {
    min-height: 17px;
    padding: 2px 10px 2px 136px;
    color: #535353;
    white-space: pre-wrap;
    font-size: 10px;
  }

  .runtime-ok {
    color: #00d400;
  }

  .runtime-info {
    color: #00dddd;
  }

  .runtime-warn {
    color: #ffe600;
  }

  .runtime-error {
    color: #ff2222;
  }

  .runtime-magenta {
    color: #ff5fff;
  }

  .runtime-message {
    position: absolute;
    top: 8px;
    left: 10px;
    z-index: 10;
    display: flex;
    gap: 7px;
    padding: 3px 6px;
    border: 1px solid #202020;
    background: rgba(0, 0, 0, 0.84);
    color: #d0d0d0;
    font-size: 10px;
    pointer-events: none;
    white-space: nowrap;
  }

  .green {
    color: #00d400;
  }

  .cyan {
    color: #00dddd;
  }

  .white {
    color: #fff;
  }

  .gray {
    color: #606060;
  }

  .red {
    color: #ff2222;
  }

  .yellow {
    color: #ffe600;
  }

  .magenta {
    color: #ff5fff;
  }

  @media (max-width: 800px) {
    .runtime-row {
      grid-template-columns:
        42px
        58px
        120px
        minmax(0, 1fr);

      font-size: 10px;
    }

    .runtime-comment {
      padding-left: 110px;
    }
  }

  @media (max-width: 560px) {
    .runtime-row {
      grid-template-columns:
        38px
        46px
        98px
        minmax(0, 1fr);

      font-size: 9px;
    }

    .runtime-comment {
      padding-left: 88px;
      font-size: 9px;
    }
  }
</style>

<script>
  // @ts-nocheck
  type Engine = {
    version(): string;
    backend(): string;
    sensor_count(): number;
    observation_size(): number;
    action_count(): number;
    model_parameter_count(): number;

    reset_ai(): void;
    reset_environment(seed: number): void;
    recover_from_collision(): void;
    hard_reset(): void;

    set_difficulty(value: number): void;
    set_obstacle_count(value: number): void;
    set_episode_steps(value: number): void;
    set_learning_rate(value: number): void;
    set_gamma(value: number): void;
    set_batch_size(value: number): void;
    set_epsilon(value: number): void;
    set_epsilon_min(value: number): void;
    set_epsilon_decay(value: number): void;
    set_target_update(value: number): void;

    current_seed(): number;
    current_step(): number;
    current_episode(): number | bigint;
    training_step_count?: () => number | bigint;
    is_done(): boolean;
    is_success(): boolean;
    is_collision(): boolean;
    last_terminal_done?: () => boolean;
    last_terminal_success?: () => boolean;
    last_terminal_collision?: () => boolean;
    last_terminal_distance?: () => number;
    epsilon(): number;
    learning_rate(): number;
    gamma(): number;
    last_loss(): number;
    last_reward(): number;
    last_episode_reward(): number;
    last_episode_steps(): number;
    replay_size(): number;

    get_observation(): number[] | Float32Array;
    get_sensor_buffer(): number[] | Float32Array;
    get_agent_buffer(): number[] | Float32Array;
    get_target_buffer(): number[] | Float32Array;
    get_obstacle_buffer(): number[] | Float32Array;
    get_path_buffer(): number[] | Float32Array;

    obstacle_count(): number;

    predict_action(): number;
    q_values(): number[] | Float32Array;

    step(action: number): number[] | Float32Array;
    train_step(): number[] | Float32Array;
    train_steps(count: number): number[] | Float32Array;
    train_episode(): number[] | Float32Array;
    train_episodes(count: number): number[] | Float32Array;
    evaluate_episodes(
      count: number,
      base_seed: number,
    ): number[] | Float32Array;

    metrics(): number[] | Float32Array;
    status_json(): string;

    export_model(): string;
    import_model(data: string): boolean;
    save_model(): string;
    load_model(data: string): boolean;
  };

  type WasmModule = {
    default: (
      input?: unknown,
    ) => Promise<unknown>;

    RayTracerEngine: new () => Engine;
  };

  type ControlsState = {
    width: number;
    height: number;
    samples: number;
    bounces: number;
    accumulation: boolean;
    exposure: number;

    cameraX: number;
    cameraY: number;
    cameraZ: number;
    cameraFov: number;
    cameraPitch: number;
    cameraYaw: number;

    lightX: number;
    lightY: number;
    lightZ: number;
    lightPower: number;

    roughness: number;
    metallic: number;
    ior: number;
    materialId: number;

    scene: string;
    objects: number;
    bvh: string;

    difficulty: number;
    obstacles: number;
    episodeSteps: number;

    learningRate: number;
    gamma: number;
    batchSize: number;
    epsilon: number;
    epsilonMin: number;
    epsilonDecay: number;
    targetUpdate: number;

    trainChunk: number;
  };

  type RuntimeSnapshot = {
    mode: string;
    state: string;
    status: string;

    backend: string;
    version: string;

    seed: number;
    step: number;
    trainingSteps: number;
    episode: number;
    episodeSteps: number;

    reward: number;
    episodeReward: number;
    loss: number;
    epsilon: number;
    learningRate: number;
    gamma: number;
    replay: number;

    success: boolean;
    collision: boolean;
    done: boolean;

    sensorCount: number;
    observationSize: number;
    actionCount: number;
    parameterCount: number;
    obstacleCount: number;

    width: number;
    height: number;
    samples: number;
    bounces: number;
  };

  const gpuCanvas =
    document.getElementById(
      "gpu-canvas",
    ) as HTMLCanvasElement | null;

  const canvas =
    document.getElementById(
      "world-canvas",
    ) as HTMLCanvasElement | null;

  const ctx =
    canvas?.getContext(
      "2d",
      {
        alpha: true,
        desynchronized: true,
      },
    );

  const runtimeScreen =
    document.getElementById(
      "runtime-screen",
    );

  const runtimeMode =
    document.getElementById(
      "runtime-mode",
    );

  const runtimeMessageText =
    document.getElementById(
      "runtime-message-text",
    );

  if (
    !canvas ||
    !ctx ||
    !runtimeScreen ||
    !runtimeMode ||
    !runtimeMessageText
  ) {
    throw new Error(
      "RAYTRC.RUNTIME DOM initialization failed",
    );
  }

  let engine: Engine | null = null;
  let wasmModule: WasmModule | null = null;

  let gpuContext: any = null;
  let gpuDevice: any = null;
  let gpuPipeline: any = null;
  let gpuUniformBuffer: any = null;
  let gpuBindGroup: any = null;
  let gpuFormat = "bgra8unorm";
  let gpuReady = false;
  let gpuLastTime = 0;

  const gpuUniformData = new Float32Array(8);

  let wasmReady = false;
  let initialized = false;
  let destroyed = false;

  let training = false;
  let trainingPreview = false;
  let runMode = false;
  let evaluation = false;

  let trainingTimer: number | null =
    null;

  let trainingWorker: Worker | null = null;
  let trainingJobId = 0;
  let lastInferenceTime = 0;
  let lastTelemetryTime = 0;

  /*
   * Collision recovery in the foreground visualizer is deliberately
   * independent of the training worker. After restoring the same map,
   * force several movement frames so the preview can never look stuck.
   */
  let recoveryMoveFrames = 0;

  const INFERENCE_INTERVAL_MS = 33;
  const TELEMETRY_INTERVAL_MS = 450;

  let frameHandle = 0;

  let controlsState: ControlsState = {
    width: 1280,
    height: 720,
    samples: 64,
    bounces: 4,
    accumulation: true,
    exposure: 1,

    cameraX: 0,
    cameraY: 1.5,
    cameraZ: 5,
    cameraFov: 45,
    cameraPitch: 0,
    cameraYaw: 0,

    lightX: 20,
    lightY: 100,
    lightZ: 10,
    lightPower: 500,

    roughness: 0.2,
    metallic: 0,
    ior: 1.5,
    materialId: 1,

    scene: "DEFAULT",
    objects: 3,
    bvh: "AUTO",

    difficulty: 3,
    obstacles: 12,
    episodeSteps: 1000,

    learningRate: 0.0005,
    gamma: 0.99,
    batchSize: 64,
    epsilon: 1,
    epsilonMin: 0.05,
    epsilonDecay: 0.9975,
    targetUpdate: 250,

    trainChunk: 250,
  };

  let snapshot: RuntimeSnapshot = {
    mode: "WAITING",
    state: "INITIALIZING",
    status: "INITIALIZING",

    backend: "UNKNOWN",
    version: "UNKNOWN",

    seed: 0,
    step: 0,
    trainingSteps: 0,
    episode: 0,
    episodeSteps: 0,

    reward: 0,
    episodeReward: 0,
    loss: 0,
    epsilon: 1,
    learningRate: 0.0005,
    gamma: 0.99,
    replay: 0,

    success: false,
    collision: false,
    done: false,

    sensorCount: 0,
    observationSize: 0,
    actionCount: 0,
    parameterCount: 0,
    obstacleCount: 0,

    width: 1280,
    height: 720,
    samples: 64,
    bounces: 4,
  };

  let sensorBuffer: number[] = [];
  let agentBuffer: number[] = [];
  let targetBuffer: number[] = [];
  let obstacleBuffer: number[] = [];
  let pathBuffer: number[] = [];

  let worldMinX = -20;
  let worldMaxX = 20;
  let worldMinZ = -20;
  let worldMaxZ = 20;

  let currentAction = 0;
  let runStallFrames = 0;
  let runLastDistance = Number.POSITIVE_INFINITY;

  let lastRenderTime = 0;
  let fps = 0;
  let renderCount = 0;

  const ACTION_NAMES = [
    "FORWARD",
    "LEFT",
    "RIGHT",
    "BRAKE",
    "REVERSE",
  ];

  const BASE = (() => {
    const raw =
      import.meta.env.BASE_URL ||
      "/";

    return raw.endsWith("/")
      ? raw
      : `${raw}/`;
  })();

  /*
   * public/ is copied as-is and served by URL.
   * Build an absolute browser URL instead of allowing
   * Vite to treat the file as a source-module dependency.
   */
  const WASM_JS_URL =
    new URL(
      "wasm/raytracer.js",
      new URL(
        BASE,
        document.baseURI,
      ),
    ).href;

  function finite(
    value: unknown,
    fallback = 0,
  ): number {
    const number =
      Number(value);

    return Number.isFinite(
      number,
    )
      ? number
      : fallback;
  }

  function integer(
    value: unknown,
    fallback = 0,
  ): number {
    return Math.floor(
      finite(
        value,
        fallback,
      ),
    );
  }

  function fixed(
    value: unknown,
    digits = 3,
  ): string {
    return finite(
      value,
    ).toFixed(
      digits,
    );
  }

  function pad(
    value: unknown,
    length: number,
  ): string {
    return String(
      integer(value),
    ).padStart(
      length,
      "0",
    );
  }

  function upper(
    value: unknown,
  ): string {
    return String(
      value ?? "",
    )
      .trim()
      .toUpperCase();
  }

  function emit(
    name: string,
    detail: Record<
      string,
      unknown
    > = {},
  ): void {
    window.dispatchEvent(
      new CustomEvent(
        name,
        {
          detail,
        },
      ),
    );
  }

  function setMessage(
    message: string,
  ): void {
    runtimeMessageText.textContent =
      message;
  }

  function setMode(
    mode: string,
  ): void {
    snapshot.mode =
      mode;

    runtimeMode!.textContent =
      mode;
  }

  function setState(
    state: string,
  ): void {
    snapshot.state =
      state;
  }

  function clearTrainingTimer(): void {
    if (
      trainingTimer !==
      null
    ) {
      window.clearTimeout(
        trainingTimer,
      );

      trainingTimer =
        null;
    }
  }

  function terminateTrainingWorker(): void {
    trainingJobId += 1;

    if (
      trainingWorker
    ) {
      try {
        trainingWorker.terminate();
      } catch {
        // Best effort during page teardown.
      }
    }

    trainingWorker =
      null;
  }

  function getTrainingConfig(): Record<string, unknown> {
    return {
      difficulty: controlsState.difficulty,
      obstacles: controlsState.obstacles,
      episodeSteps: controlsState.episodeSteps,
      learningRate: controlsState.learningRate,
      gamma: controlsState.gamma,
      batchSize: controlsState.batchSize,
      epsilon: controlsState.epsilon,
      epsilonMin: controlsState.epsilonMin,
      epsilonDecay: controlsState.epsilonDecay,
      targetUpdate: controlsState.targetUpdate,
    };
  }

  function applyWorkerTelemetry(
    data: Record<string, unknown>,
  ): void {
    snapshot.mode =
      String(
        data.mode ??
          snapshot.mode,
      );

    snapshot.state =
      String(
        data.state ??
          snapshot.state,
      );

    snapshot.status =
      String(
        data.status ??
          snapshot.status,
      );

    snapshot.seed =
      finite(
        data.seed,
        snapshot.seed,
      );

    snapshot.step =
      finite(
        data.step,
        snapshot.step,
      );

    snapshot.trainingSteps =
      finite(
        data.trainingSteps,
        snapshot.trainingSteps,
      );

    snapshot.episode =
      finite(
        data.episode,
        snapshot.episode,
      );

    snapshot.episodeSteps =
      finite(
        data.episodeSteps,
        snapshot.episodeSteps,
      );

    snapshot.reward =
      finite(
        data.reward,
        snapshot.reward,
      );

    snapshot.episodeReward =
      finite(
        data.episodeReward,
        snapshot.episodeReward,
      );

    snapshot.loss =
      finite(
        data.loss,
        snapshot.loss,
      );

    snapshot.epsilon =
      finite(
        data.epsilon,
        snapshot.epsilon,
      );

    snapshot.replay =
      finite(
        data.replay,
        snapshot.replay,
      );

  }

  function handleTrainingWorkerMessage(
    event: MessageEvent,
  ): void {
    const data =
      (event.data ?? {}) as Record<string, unknown>;

    const jobId =
      finite(
        data.jobId,
        -1,
      );

    if (
      jobId !==
      trainingJobId
    ) {
      return;
    }

    const type =
      upper(
        data.type,
      );

    if (
      type ===
      "PROGRESS"
    ) {
      const previewModel =
        typeof data.previewModel ===
          "string"
          ? data.previewModel
          : "";

      if (
        previewModel &&
        engine
      ) {
        try {
          const imported =
            engine.import_model(
              previewModel,
            );

          if (imported) {
            syncWorldBuffers();
          }
        } catch (error) {
          handleRuntimeError(error);
          return;
        }
      }

      applyWorkerTelemetry(
        {
          ...data,
          state: "RUNNING",
        },
      );

      const completed =
        finite(
          data.completed,
          0,
        );

      const requested =
        finite(
          data.requested,
          0,
        );

      snapshot.status =
        requested > 0
          ? `TRAINING ${completed}/${requested}`
          : `TRAINING ${completed}`;

      setMessage(
        runMode
          ? (requested > 0
              ? `RUN + TRAIN ${completed}/${requested} / CPU WORKER`
              : `RUN + TRAIN ${completed} / CPU WORKER`)
          : (requested > 0
              ? `TRAINING ${completed}/${requested} / CPU WORKER`
              : `CONTINUOUS TRAINING ${completed} / CPU WORKER`),
      );

      emit(
        "raytracer:training-progress",
        {
          source: "worker",
          ...data,
        },
      );

      emitAIState();
      renderRuntime();
      return;
    }

    if (
      type ===
      "COMPLETE"
    ) {
      const model =
        String(
          data.model ?? "",
        );

      if (
        model &&
        engine
      ) {
        try {
          const imported =
            engine.import_model(
              model,
            );

          if (!imported) {
            throw new Error(
              "trained model import rejected by runtime",
            );
          }
        } catch (error) {
          terminateTrainingWorker();
          training = false;
          evaluation = false;
          handleRuntimeError(
            error,
          );
          return;
        }
      }

      applyWorkerTelemetry(
        data,
      );

      training =
        false;

      trainingPreview =
        false;

      evaluation =
        false;

      setMode(
        upper(
          data.mode ??
            "TRAIN",
        ),
      );

      setState(
        "COMPLETE",
      );

      snapshot.status =
        String(
          data.status ??
            "TRAINING COMPLETE",
        );

      setMessage(
        String(
          data.message ??
            "TRAINING COMPLETE / MODEL APPLIED",
        ),
      );

      terminateTrainingWorker();
      clearTrainingTimer();

      if (
        engine
      ) {
        syncWorldBuffers();
      }

      emit(
        "raytracer:training-complete",
        {
          source: "worker",
          ...data,
        },
      );

      emitAIState();
      renderRuntime();
      drawWorld();
      return;
    }

    if (
      type ===
      "EVAL_COMPLETE"
    ) {
      evaluation =
        false;

      setMode(
        "EVAL",
      );

      setState(
        "COMPLETE",
      );

      const average =
        finite(
          data.average,
          0,
        );

      snapshot.status =
        `EVAL AVG ${average.toFixed(6)}`;

      setMessage(
        `EVALUATION COMPLETE / AVG ${average.toFixed(6)}`,
      );

      emit(
        "raytracer:ai-eval",
        {
          source: "worker",
          ...data,
        },
      );

      terminateTrainingWorker();
      renderRuntime();
      emitAIState();
      return;
    }

    if (
      type ===
      "ERROR"
    ) {
      terminateTrainingWorker();
      training =
        false;
      evaluation =
        false;

      handleRuntimeError(
        new Error(
          String(
            data.message ??
              "background worker failed",
          ),
        ),
      );
    }
  }

  function startTrainingWorker(
    mode:
      | "steps"
      | "episodes"
      | "continuous",
    count = 0,
  ): void {
    if (
      !engine
    ) {
      setMessage(
        "RUNTIME NOT READY",
      );
      return;
    }

    terminateTrainingWorker();
    clearTrainingTimer();

    training =
      true;

    // Training and foreground RUN are independent.
    // When RUN is already active, keep it active.
    // When RUN is idle, training gets a live preview.
    trainingPreview =
      true;

    recoveryMoveFrames =
      0;

    evaluation =
      false;

    const requested =
      mode === "continuous"
        ? 0
        : clampInt(
            count,
            1,
            mode === "steps"
              ? 1000000
              : 100000,
          );

    const model =
      engine.export_model();

    const seed =
      finite(
        engine.current_seed(),
        Date.now() >>> 0,
      );

    const jobId =
      ++trainingJobId;

    const worker =
      new Worker(
        new URL(
          "../workers/training.worker.ts",
          import.meta.url,
        ),
        {
          type: "module",
        },
      );

    trainingWorker =
      worker;

    worker.addEventListener(
      "message",
      handleTrainingWorkerMessage,
    );

    worker.addEventListener(
      "error",
      (event) => {
        if (
          jobId !==
          trainingJobId
        ) {
          return;
        }

        terminateTrainingWorker();

        training =
          false;

        evaluation =
          false;

        handleRuntimeError(
          event.error ??
            new Error(
              event.message ||
                "training worker error",
            ),
        );
      },
    );

    setMode(
      mode === "episodes"
        ? "TRAIN-EPISODES"
        : "TRAIN",
    );

    setState(
      "RUNNING",
    );

    snapshot.status =
      mode === "continuous"
        ? "CONTINUOUS TRAINING"
        : `TRAINING ${requested}`;

    setMessage(
      mode === "continuous"
        ? "AI TRAINING / CPU WORKER"
        : `AI TRAINING ${requested} / CPU WORKER`,
    );

    emit(
      "raytracer:training-start",
      {
        source: "worker",
        mode,
        requested,
      },
    );

    worker.postMessage(
      {
        type: "START",
        jobId,
        mode,
        requested,
        chunk: clampInt(
          controlsState.trainChunk || 1024,
          128,
          2048,
        ),
        seed,
        model,
        config:
          getTrainingConfig(),
      },
    );

    renderRuntime();
    emitAIState();
  }

