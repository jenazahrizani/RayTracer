  }

  function clampInt(
    value: unknown,
    min: number,
    max: number,
  ): number {
    return Math.min(
      max,
      Math.max(
        min,
        Math.floor(
          finite(
            value,
            min,
          ),
        ),
      ),
    );
  }

  function clampFloat(
    value: unknown,
    min: number,
    max: number,
  ): number {
    return Math.min(
      max,
      Math.max(
        min,
        finite(
          value,
          min,
        ),
      ),
    );
  }

  function applyControls(
    next: Partial<ControlsState>,
  ): void {
    controlsState = {
      ...controlsState,
      ...next,
    };

    if (!engine) {
      return;
    }

    try {
      if (
        next.difficulty !==
        undefined
      ) {
        engine.set_difficulty(
          clampInt(
            next.difficulty,
            1,
            10,
          ),
        );
      }

      if (
        next.obstacles !==
        undefined
      ) {
        engine.set_obstacle_count(
          clampInt(
            next.obstacles,
            1,
            64,
          ),
        );
      }

      if (
        next.episodeSteps !==
        undefined
      ) {
        engine.set_episode_steps(
          clampInt(
            next.episodeSteps,
            50,
            5000,
          ),
        );
      }

      if (
        next.learningRate !==
        undefined
      ) {
        engine.set_learning_rate(
          clampFloat(
            next.learningRate,
            0.00001,
            0.1,
          ),
        );
      }

      if (
        next.gamma !==
        undefined
      ) {
        engine.set_gamma(
          clampFloat(
            next.gamma,
            0.80,
            0.9999,
          ),
        );
      }

      if (
        next.batchSize !==
        undefined
      ) {
        engine.set_batch_size(
          clampInt(
            next.batchSize,
            1,
            256,
          ),
        );
      }

      if (
        next.epsilon !==
        undefined
      ) {
        engine.set_epsilon(
          clampFloat(
            next.epsilon,
            0,
            1,
          ),
        );
      }

      if (
        next.epsilonMin !==
        undefined
      ) {
        engine.set_epsilon_min(
          clampFloat(
            next.epsilonMin,
            0,
            1,
          ),
        );
      }

      if (
        next.epsilonDecay !==
        undefined
      ) {
        engine.set_epsilon_decay(
          clampFloat(
            next.epsilonDecay,
            0.9,
            0.999999,
          ),
        );
      }

      if (
        next.targetUpdate !==
        undefined
      ) {
        engine.set_target_update(
          clampInt(
            next.targetUpdate,
            1,
            100000,
          ),
        );
      }

      snapshot.width =
        clampInt(
          controlsState.width,
          1,
          16384,
        );

      snapshot.height =
        clampInt(
          controlsState.height,
          1,
          16384,
        );

      snapshot.samples =
        clampInt(
          controlsState.samples,
          1,
          1000000,
        );

      snapshot.bounces =
        clampInt(
          controlsState.bounces,
          1,
          128,
        );

      emit(
        "raytracer:controls-applied",
        {
          state: {
            ...controlsState,
          },
        },
      );

      syncSnapshot();
    } catch (error) {
      handleRuntimeError(
        error,
      );
    }
  }

  function calculateWorldBounds(): void {
    let minX =
      Number.POSITIVE_INFINITY;

    let maxX =
      Number.NEGATIVE_INFINITY;

    let minZ =
      Number.POSITIVE_INFINITY;

    let maxZ =
      Number.NEGATIVE_INFINITY;

    function inspectPoint(
      x: number,
      z: number,
    ): void {
      if (
        !Number.isFinite(x) ||
        !Number.isFinite(z)
      ) {
        return;
      }

      minX =
        Math.min(
          minX,
          x,
        );

      maxX =
        Math.max(
          maxX,
          x,
        );

      minZ =
        Math.min(
          minZ,
          z,
        );

      maxZ =
        Math.max(
          maxZ,
          z,
        );
    }

    if (
      agentBuffer.length >= 3
    ) {
      inspectPoint(
        agentBuffer[0],
        agentBuffer[2],
      );
    }

    if (
      targetBuffer.length >= 3
    ) {
      inspectPoint(
        targetBuffer[0],
        targetBuffer[2],
      );
    }

    /*
     * Rust obstacle format:
     *
     * 8 floats / obstacle
     *
     * [0] center.x
     * [1] center.y
     * [2] center.z
     * [3] half.x
     * [4] half.y
     * [5] half.z
     * [6] material
     * [7] reserved
     */
    if (
      obstacleBuffer.length >= 8
    ) {
      for (
        let i = 0;
        i + 7 <
        obstacleBuffer.length;
        i += 8
      ) {
        const centerX =
          obstacleBuffer[i];

        const centerZ =
          obstacleBuffer[
            i + 2
          ];

        const halfX =
          Math.abs(
            obstacleBuffer[
              i + 3
            ],
          );

        const halfZ =
          Math.abs(
            obstacleBuffer[
              i + 5
            ],
          );

        inspectPoint(
          centerX - halfX,
          centerZ - halfZ,
        );

        inspectPoint(
          centerX + halfX,
          centerZ + halfZ,
        );
      }
    } else if (
      obstacleBuffer.length >= 4
    ) {
      /*
       * Legacy fallback:
       *
       * [minX, minZ, maxX, maxZ]
       */
      for (
        let i = 0;
        i + 3 <
        obstacleBuffer.length;
        i += 4
      ) {
        inspectPoint(
          obstacleBuffer[i],
          obstacleBuffer[
            i + 1
          ],
        );

        inspectPoint(
          obstacleBuffer[
            i + 2
          ],
          obstacleBuffer[
            i + 3
          ],
        );
      }
    }

    /*
     * Rust path format:
     *
     * 3 floats / point
     *
     * [x, y, z]
     */
    if (
      pathBuffer.length >= 3
    ) {
      for (
        let i = 0;
        i + 2 <
        pathBuffer.length;
        i += 3
      ) {
        inspectPoint(
          pathBuffer[i],
          pathBuffer[
            i + 2
          ],
        );
      }
    }

    if (
      !Number.isFinite(minX) ||
      !Number.isFinite(maxX) ||
      !Number.isFinite(minZ) ||
      !Number.isFinite(maxZ)
    ) {
      minX = -12;
      maxX = 12;
      minZ = -12;
      maxZ = 12;
    }

    const width =
      Math.max(
        10,
        maxX - minX,
      );

    const height =
      Math.max(
        10,
        maxZ - minZ,
      );

    const paddingX =
      Math.max(
        2,
        width * 0.12,
      );

    const paddingZ =
      Math.max(
        2,
        height * 0.12,
      );

    worldMinX =
      minX - paddingX;

    worldMaxX =
      maxX + paddingX;

    worldMinZ =
      minZ - paddingZ;

    worldMaxZ =
      maxZ + paddingZ;
  }

  function worldToScreen(
    x: number,
    z: number,
  ): [number, number] {
    const width =
      canvas!.width;

    const height =
      canvas!.height;

    const rangeX =
      Math.max(
        1,
        worldMaxX -
          worldMinX,
      );

    const rangeZ =
      Math.max(
        1,
        worldMaxZ -
          worldMinZ,
      );

    const scale =
      Math.min(
        width / rangeX,
        height / rangeZ,
      ) * 0.84;

    const centerX =
      (worldMinX +
        worldMaxX) /
      2;

    const centerZ =
      (worldMinZ +
        worldMaxZ) /
      2;

    const sx =
      width / 2 +
      (x - centerX) *
        scale;

    const sy =
      height / 2 +
      (z - centerZ) *
        -scale;

    return [
      sx,
      sy,
    ];
  }

  function resizeCanvas(): void {
    const rect =
      canvas!.getBoundingClientRect();

    const dpr =
      Math.min(
        window.devicePixelRatio ||
          1,
        2,
      );

    const width =
      Math.max(
        1,
        Math.round(
          rect.width *
            dpr,
        ),
      );

    const height =
      Math.max(
        1,
        Math.round(
          rect.height *
            dpr,
        ),
      );

    if (
      canvas!.width !==
        width ||
      canvas!.height !==
        height
    ) {
      canvas!.width =
        width;

      canvas!.height =
        height;
    }

    if (gpuCanvas) {
      const gpuWidth =
        Math.max(1, Math.round(rect.width * Math.min(dpr, 1.5)));
      const gpuHeight =
        Math.max(1, Math.round(rect.height * Math.min(dpr, 1.5)));

      if (
        gpuCanvas.width !== gpuWidth ||
        gpuCanvas.height !== gpuHeight
      ) {
        gpuCanvas.width = gpuWidth;
        gpuCanvas.height = gpuHeight;
      }
    }

    ctx!.setTransform(
      1,
      0,
      0,
      1,
      0,
      0,
    );
  }

  const GPU_SHADER = `
struct Frame {
  screenTime: vec4<f32>,
  agentTarget: vec4<f32>,
};

@group(0) @binding(0)
var<uniform> frame: Frame;

struct VSOut {
  @builtin(position) position: vec4<f32>,
  @location(0) uv: vec2<f32>,
};

@vertex
fn vsMain(@builtin(vertex_index) vertexIndex: u32) -> VSOut {
  var positions = array<vec2<f32>, 3>(
    vec2<f32>(-1.0, -3.0),
    vec2<f32>( 3.0,  1.0),
    vec2<f32>(-1.0,  1.0)
  );

  let p = positions[vertexIndex];

  var out: VSOut;
  out.position = vec4<f32>(p, 0.0, 1.0);
  out.uv = p * 0.5 + vec2<f32>(0.5);
  return out;
}

fn hash2(p: vec2<f32>) -> f32 {
  let h = dot(p, vec2<f32>(127.1, 311.7));
  return fract(sin(h) * 43758.5453);
}

@fragment
fn fsMain(input: VSOut) -> @location(0) vec4<f32> {
  let resolution = frame.screenTime.xy;
  let time = frame.screenTime.z;
  let seed = frame.screenTime.w;
  let uv = input.uv;
  let aspect = resolution.x / max(resolution.y, 1.0);

  var p = (uv - vec2<f32>(0.5)) * vec2<f32>(aspect, 1.0);

  var color = vec3<f32>(0.002, 0.006, 0.004);

  let gridScale = 18.0;
  let g = abs(fract(p * gridScale - 0.5) - 0.5) / fwidth(p * gridScale);
  let line = 1.0 - min(min(g.x, g.y), 1.0);
  color += vec3<f32>(0.0, 0.035, 0.012) * line * 0.26;

  let sweep = 0.5 + 0.5 * sin(time * 1.7 + p.y * 35.0 + seed * 0.001);
  color += vec3<f32>(0.0, 0.008, 0.002) * sweep;

  let agent = vec2<f32>(
    frame.agentTarget.x,
    frame.agentTarget.y
  );

  let target = vec2<f32>(
    frame.agentTarget.z,
    frame.agentTarget.w
  );

  let da = max(length(p - agent * 0.035), 0.0001);
  let dt = max(length(p - target * 0.035), 0.0001);

  let ag = exp(-da * 38.0);
  let tg = exp(-dt * 46.0);

  color += vec3<f32>(0.0, 0.17, 0.045) * ag;
  color += vec3<f32>(0.02, 0.12, 0.05) * tg;

  // Small real GPU workload: animated field perturbation used by the background.
  var field = 0.0;
  var q = p * 2.7;
  for (var i = 0u; i < 8u; i = i + 1u) {
    field += sin(q.x * 3.0 + time * 0.8 + f32(i) * 0.7)
      * cos(q.y * 4.0 - time * 0.6 - f32(i) * 0.35) * 0.012;
    q = q * 1.37 + vec2<f32>(0.17, -0.11);
  }

  color += vec3<f32>(0.0, max(field, 0.0), 0.0);

  let vignette = smoothstep(1.25, 0.15, dot(p, p));
  color *= vignette;

  return vec4<f32>(color, 1.0);
}
`;

  async function initWebGPU(): Promise<void> {
    gpuReady = false;

    if (!gpuCanvas || !(navigator as any).gpu) {
      emit("raytracer:gpu", {
        available: false,
        backend: "CANVAS2D",
        status: "WEBGPU UNAVAILABLE",
      });
      return;
    }

    try {
      const adapter = await (navigator as any).gpu.requestAdapter({
        powerPreference: "high-performance",
      });

      if (!adapter) {
        throw new Error("WEBGPU ADAPTER NOT FOUND");
      }

      gpuDevice = await adapter.requestDevice({
        label: "RAYTRC.GPU.DEVICE",
      });

      gpuContext = gpuCanvas.getContext("webgpu");
      if (!gpuContext) {
        throw new Error("WEBGPU CANVAS CONTEXT NOT FOUND");
      }

      gpuFormat = (navigator as any).gpu.getPreferredCanvasFormat();

      gpuContext.configure({
        device: gpuDevice,
        format: gpuFormat,
        alphaMode: "opaque",
      });

      const module = gpuDevice.createShaderModule({
        label: "RAYTRC.GPU.BACKGROUND",
        code: GPU_SHADER,
      });

      gpuPipeline = gpuDevice.createRenderPipeline({
        label: "RAYTRC.GPU.FRAME",
        layout: "auto",
        vertex: {
          module,
          entryPoint: "vsMain",
        },
        fragment: {
          module,
          entryPoint: "fsMain",
          targets: [{ format: gpuFormat }],
        },
        primitive: {
          topology: "triangle-list",
        },
      });

      gpuUniformBuffer = gpuDevice.createBuffer({
        label: "RAYTRC.GPU.UNIFORMS",
        size: 32,
        usage:
          (GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST),
      });

      gpuBindGroup = gpuDevice.createBindGroup({
        label: "RAYTRC.GPU.BINDGROUP",
        layout: gpuPipeline.getBindGroupLayout(0),
        entries: [
          {
            binding: 0,
            resource: {
              buffer: gpuUniformBuffer,
            },
          },
        ],
      });

      gpuReady = true;
      resizeCanvas();

      emit("raytracer:gpu", {
        available: true,
        backend: "WEBGPU",
        status: "GPU READY",
        format: gpuFormat,
      });
    } catch (error) {
      gpuReady = false;
      gpuContext = null;
      gpuDevice = null;
      gpuPipeline = null;

      emit("raytracer:gpu", {
        available: false,
        backend: "CANVAS2D",
        status:
          error instanceof Error
            ? `WEBGPU FAILED: ${error.message}`
            : "WEBGPU FAILED",
      });
    }
  }

  function renderWebGPU(timestamp: number): void {
    if (
      !gpuReady ||
      !gpuDevice ||
      !gpuContext ||
      !gpuPipeline ||
      !gpuUniformBuffer ||
      !gpuBindGroup ||
      !gpuCanvas
    ) {
      return;
    }

    const agent = parseAgent();
    const target = parseTarget();

    gpuUniformData[0] = gpuCanvas.width;
    gpuUniformData[1] = gpuCanvas.height;
    gpuUniformData[2] = timestamp * 0.001;
    gpuUniformData[3] = finite(snapshot.seed);
    gpuUniformData[4] = agent.x;
    gpuUniformData[5] = agent.z;
    gpuUniformData[6] = target.x;
    gpuUniformData[7] = target.z;

    gpuDevice.queue.writeBuffer(
      gpuUniformBuffer,
      0,
      gpuUniformData,
    );

    const encoder = gpuDevice.createCommandEncoder({
      label: "RAYTRC.GPU.FRAME",
    });

    const pass = encoder.beginRenderPass({
      colorAttachments: [
        {
          view: gpuContext.getCurrentTexture().createView(),
          clearValue: {
            r: 0,
            g: 0,
            b: 0,
            a: 1,
          },
          loadOp: "clear",
          storeOp: "store",
        },
      ],
    });

    pass.setPipeline(gpuPipeline);
    pass.setBindGroup(0, gpuBindGroup);
    pass.draw(3, 1, 0, 0);
    pass.end();

    gpuDevice.queue.submit([encoder.finish()]);
    gpuLastTime = timestamp;
  }

  function clearCanvas(): void {
    ctx!.clearRect(
      0,
      0,
      canvas!.width,
      canvas!.height,
    );
  }

  function drawGrid(): void {
    const context =
      ctx!;

    const width =
      canvas!.width;

    const height =
      canvas!.height;

    const rangeX =
      Math.max(
        1,
        worldMaxX -
          worldMinX,
      );

    const rangeZ =
      Math.max(
        1,
        worldMaxZ -
          worldMinZ,
      );

    const gridStep =
      Math.max(
        1,
        Math.ceil(
          Math.max(
            rangeX,
            rangeZ,
          ) / 20,
        ),
      );

    context.save();

    context.lineWidth =
      1;

    context.strokeStyle =
      "#0a1b0a";

    const startX =
      Math.ceil(
        worldMinX /
          gridStep,
      ) *
      gridStep;

    for (
      let x = startX;
      x <= worldMaxX;
      x += gridStep
    ) {
      const [
        sx1,
        sy1,
      ] =
        worldToScreen(
          x,
          worldMinZ,
        );

      const [
        sx2,
        sy2,
      ] =
        worldToScreen(
          x,
          worldMaxZ,
        );

      context.beginPath();

      context.moveTo(
        sx1,
        sy1,
      );

      context.lineTo(
        sx2,
        sy2,
      );

      context.stroke();
    }

    const startZ =
      Math.ceil(
        worldMinZ /
          gridStep,
      ) *
      gridStep;

    for (
      let z = startZ;
      z <= worldMaxZ;
      z += gridStep
    ) {
      const [
        sx1,
        sy1,
      ] =
        worldToScreen(
          worldMinX,
          z,
        );

      const [
        sx2,
        sy2,
      ] =
        worldToScreen(
          worldMaxX,
          z,
        );

      context.beginPath();

      context.moveTo(
        sx1,
        sy1,
      );

      context.lineTo(
        sx2,
        sy2,
      );

      context.stroke();
    }

    context.strokeStyle =
      "#163316";

    context.beginPath();

    const [
      axisX1,
      axisY1,
    ] =
      worldToScreen(
        0,
        worldMinZ,
      );

    const [
      axisX2,
      axisY2,
    ] =
      worldToScreen(
        0,
        worldMaxZ,
      );

    context.moveTo(
      axisX1,
      axisY1,
    );

    context.lineTo(
      axisX2,
      axisY2,
    );

    context.stroke();

    context.beginPath();

    const [
      axisZ1,
      axisW1,
    ] =
      worldToScreen(
        worldMinX,
        0,
      );

    const [
      axisZ2,
      axisW2,
    ] =
      worldToScreen(
        worldMaxX,
        0,
      );

    context.moveTo(
      axisZ1,
      axisW1,
    );

    context.lineTo(
      axisZ2,
      axisW2,
    );

    context.stroke();

    context.restore();
  }

  function drawObstacles(): void {
    const context =
      ctx!;

    context.save();

    context.fillStyle =
      "rgba(255,34,34,0.10)";

    context.strokeStyle =
      "#ff2222";

    context.lineWidth =
      1;

    /*
     * Rust format:
     *
     * [center.x, center.y, center.z,
     *  half.x,   half.y,   half.z,
     *  material, reserved]
     */
    if (
      obstacleBuffer.length >=
      8
    ) {
      for (
        let i = 0;
        i + 7 <
        obstacleBuffer.length;
        i += 8
      ) {
        const centerX =
          obstacleBuffer[
            i
          ];

        const centerZ =
          obstacleBuffer[
            i + 2
          ];

        const halfX =
          Math.abs(
            obstacleBuffer[
              i + 3
            ],
          );

        const halfZ =
          Math.abs(
            obstacleBuffer[
              i + 5
            ],
          );

        const minX =
          centerX - halfX;

        const minZ =
          centerZ - halfZ;

        const maxX =
          centerX + halfX;

        const maxZ =
          centerZ + halfZ;

        const [
          sx1,
          sy1,
        ] =
          worldToScreen(
            minX,
            minZ,
          );

        const [
          sx2,
          sy2,
        ] =
          worldToScreen(
            maxX,
            maxZ,
          );

        const left =
          Math.min(
            sx1,
            sx2,
          );

        const top =
          Math.min(
            sy1,
            sy2,
          );

        const rectWidth =
          Math.abs(
            sx2 - sx1,
          );

        const rectHeight =
          Math.abs(
            sy2 - sy1,
          );

        context.fillRect(
          left,
          top,
          rectWidth,
          rectHeight,
        );

        context.strokeRect(
          left,
          top,
          rectWidth,
          rectHeight,
        );
      }
    } else if (
      obstacleBuffer.length >=
      4
    ) {
      /*
       * Legacy fallback:
       *
       * [minX, minZ, maxX, maxZ]
       */
      for (
        let i = 0;
        i + 3 <
        obstacleBuffer.length;
        i += 4
      ) {
        const [
          sx1,
          sy1,
        ] =
          worldToScreen(
            obstacleBuffer[i],
            obstacleBuffer[
              i + 1
            ],
          );

        const [
          sx2,
          sy2,
        ] =
          worldToScreen(
            obstacleBuffer[
              i + 2
            ],
            obstacleBuffer[
              i + 3
            ],
          );

        const left =
          Math.min(
            sx1,
            sx2,
          );

        const top =
          Math.min(
            sy1,
            sy2,
          );

        const rectWidth =
          Math.abs(
            sx2 - sx1,
          );

        const rectHeight =
          Math.abs(
            sy2 - sy1,
          );

        context.fillRect(
          left,
          top,
          rectWidth,
          rectHeight,
        );

        context.strokeRect(
          left,
          top,
          rectWidth,
          rectHeight,
        );
      }
    }

    context.restore();
  }

  function drawPath(): void {
    if (
      pathBuffer.length <
      3
    ) {
      return;
    }

    const context =
      ctx!;

    context.save();

    context.strokeStyle =
      "#00dddd";

    context.globalAlpha =
      0.35;

    context.lineWidth =
      1;

    context.beginPath();

    let started =
      false;

    /*
     * Rust path format:
     *
     * [x, y, z]
     */
    for (
      let i = 0;
      i + 2 <
      pathBuffer.length;
      i += 3
    ) {
      const x =
        finite(
          pathBuffer[i],
        );

      const z =
        finite(
          pathBuffer[
            i + 2
          ],
        );

      const [
        sx,
        sy,
      ] =
        worldToScreen(
          x,
          z,
        );

      if (!started) {
        context.moveTo(
          sx,
          sy,
        );

        started =
          true;
      } else {
        context.lineTo(
          sx,
          sy,
        );
      }
    }

    if (started) {
      context.stroke();
    }

    context.restore();
  }

  function parseAgent(): {
    x: number;
    z: number;
    heading: number;
    speed: number;
  } {
    /*
     * Rust:
     *
     * [x, y, z, heading, speed, radius, collision, success]
     */
    if (
      agentBuffer.length >=
      5
    ) {
      return {
        x:
          finite(
            agentBuffer[0],
          ),

        z:
          finite(
            agentBuffer[2],
          ),

        heading:
          finite(
            agentBuffer[3],
          ),

        speed:
          finite(
            agentBuffer[4],
          ),
      };
    }

    if (
      agentBuffer.length >=
      4
    ) {
      return {
        x:
          finite(
            agentBuffer[0],
          ),

        z:
          finite(
            agentBuffer[1],
          ),

        heading:
          finite(
            agentBuffer[2],
          ),

        speed:
          finite(
            agentBuffer[3],
          ),
      };
    }

    if (
      agentBuffer.length >=
      3
    ) {
      return {
        x:
          finite(
            agentBuffer[0],
          ),

        z:
          finite(
            agentBuffer[2],
          ),

        heading:
          0,

        speed:
          0,
      };
    }

    return {
      x: 0,
      z: 0,
      heading: 0,
      speed: 0,
    };
  }

  function parseTarget(): {
    x: number;
    z: number;
  } {
    /*
     * Rust:
     *
     * [x, y, z, radius]
     */
    if (
      targetBuffer.length >=
      3
    ) {
      return {
        x:
          finite(
            targetBuffer[0],
          ),

        z:
          finite(
            targetBuffer[2],
          ),
      };
    }

    if (
      targetBuffer.length >=
      2
    ) {
      return {
        x:
          finite(
            targetBuffer[0],
          ),

        z:
          finite(
            targetBuffer[1],
          ),
      };
    }

    return {
      x: 0,
      z: 0,
    };
  }

  function drawTarget(): void {
    const target =
      parseTarget();

    const [
      sx,
      sy,
    ] =
      worldToScreen(
        target.x,
        target.z,
      );

    const context =
      ctx!;

    context.save();

    context.strokeStyle =
      "#00d400";

    context.fillStyle =
      "rgba(0,212,0,0.08)";

    context.lineWidth =
      1;

    context.beginPath();

    context.arc(
      sx,
      sy,
      11,
      0,
      Math.PI * 2,
    );

    context.fill();
    context.stroke();

    context.beginPath();

    context.moveTo(
      sx - 16,
      sy,
    );

    context.lineTo(
      sx + 16,
      sy,
    );

    context.moveTo(
      sx,
      sy - 16,
    );

    context.lineTo(
      sx,
      sy + 16,
    );

    context.stroke();

    context.font =
      "10px IBM Plex Mono, Courier New, monospace";

    context.fillStyle =
      "#00d400";

    context.fillText(
      "TARGET",
      sx + 14,
      sy - 12,
    );

    context.restore();
  }

  function drawSensors(
    agent: {
      x: number;
      z: number;
      heading: number;
      speed: number;
    },
  ): void {
    if (
      sensorBuffer.length ===
      0
    ) {
      return;
    }

    const context =
      ctx!;

    const count =
      sensorBuffer.length;

    const [
      originX,
      originY,
    ] =
      worldToScreen(
        agent.x,
        agent.z,
      );

    const maxWorldRange =
      Math.max(
        worldMaxX -
          worldMinX,

        worldMaxZ -
          worldMinZ,
      );

    const maxSensorDistance =
      Math.max(
        1,
        maxWorldRange *
          0.45,
      );

    context.save();

    for (
      let i = 0;
      i < count;
      i += 1
    ) {
      const value =
        Math.min(
          1,
          Math.max(
            0,
            finite(
              sensorBuffer[i],
            ),
          ),
        );

      /*
       * Rust sensor direction:
       *
       * x = sin(angle)
       * z = cos(angle)
       */
      const angle =
        agent.heading +
        (i / count) *
          Math.PI *
          2;

      const distance =
        Math.max(
          0.5,
          value *
            maxSensorDistance,
        );

      const endWorldX =
        agent.x +
        Math.sin(angle) *
          distance;

      const endWorldZ =
        agent.z +
        Math.cos(angle) *
          distance;

      const [
        endX,
        endY,
      ] =
        worldToScreen(
          endWorldX,
          endWorldZ,
        );

      context.globalAlpha =
        0.20 +
        (1 - value) *
          0.70;

      context.strokeStyle =
        "#ff5fff";

      context.lineWidth =
        1;

      context.beginPath();

      context.moveTo(
        originX,
        originY,
      );

      context.lineTo(
        endX,
        endY,
      );

      context.stroke();
    }

    context.restore();
  }

  function drawAgent(): void {
    const agent =
      parseAgent();

    const [
      sx,
      sy,
    ] =
      worldToScreen(
        agent.x,
        agent.z,
      );

    drawSensors(
      agent,
    );

    const context =
      ctx!;

    context.save();

    context.translate(
      sx,
      sy,
    );

    /*
     * Rust world heading:
     *
     * x = sin(heading)
     * z = cos(heading)
     *
     * Canvas coordinates invert Y.
     *
     * Therefore the screen-space angle from +X is:
     *
     * heading - PI/2
     */
    context.rotate(
      agent.heading -
        Math.PI / 2,
    );

    context.fillStyle =
      "#00dddd";

    context.strokeStyle =
      "#fff";

    context.lineWidth =
      1;

    context.beginPath();

    context.moveTo(
      12,
      0,
    );

    context.lineTo(
      -8,
      -7,
    );

    context.lineTo(
      -4,
      0,
    );

    context.lineTo(
      -8,
      7,
    );

    context.closePath();

    context.fill();
    context.stroke();

    context.restore();

    context.save();

    context.font =
      "10px IBM Plex Mono, Courier New, monospace";

    context.fillStyle =
      "#00dddd";

    context.fillText(
      "AGENT",
      sx + 13,
      sy + 14,
    );

    context.fillStyle =
      "#606060";

    context.fillText(
      `A${currentAction}`,
      sx + 13,
      sy + 26,
    );

    context.restore();
  }

  function drawStatusMark(): void {
    const context =
      ctx!;

    const width =
      canvas!.width;

    context.save();

    context.font =
      "10px IBM Plex Mono, Courier New, monospace";

    context.fillStyle =
      "#505050";

    context.fillText(
      `SEED ${pad(
        snapshot.seed,
        10,
      )}`,
      10,
      18,
    );

    context.fillText(
      `EP ${pad(
        snapshot.episode,
        8,
      )}`,
      10,
      32,
    );

    context.fillText(
      `ENV ${pad(
        snapshot.step,
        6,
      )}`,
      10,
      46,
    );

    context.fillText(
      `TRN ${pad(
        snapshot.trainingSteps,
        8,
      )}`,
      10,
      60,
    );

    context.fillText(
      `EPS ${snapshot.epsilon.toFixed(
        4,
      )}`,
      10,
      74,
    );

    context.fillText(
      `RWD ${snapshot.reward.toFixed(
        4,
      )}`,
      10,
      88,
    );

    const widthLabel =
      `${Math.round(
        width /
          (window.devicePixelRatio ||
            1),
      )}PX`;

    context.fillText(
      widthLabel,
      Math.max(
        0,
        width - 55,
      ),
      18,
    );

    context.restore();
  }

  function drawWorld(): void {
    clearCanvas();
    drawGrid();
    drawObstacles();
    drawPath();
    drawTarget();
    drawAgent();
    drawStatusMark();
  }

  function runOneInferenceStep(): void {
    if (
      !engine ||
      evaluation ||
      (!runMode && !trainingPreview)
    ) {
      return;
    }

    const previewIsTraining =
      trainingPreview &&
      !runMode;

    try {
      /*
       * TERMINAL POLICY
       *
       * SUCCESS:
       *   Visual HOLD. The user explicitly presses RUN for another map.
       *
       * COLLISION:
       *   Terminal for DQN learning, but recoverable for the foreground
       *   visualizer. RUN and TRAIN PREVIEW use the same recovery path.
       */
      if (engine.is_done()) {
        const terminalCollision =
          engine.is_collision();

        const terminalSuccess =
          engine.is_success();

        if (
          terminalCollision &&
          (
            runMode ||
            previewIsTraining
          )
        ) {
          engine.recover_from_collision();

          recoveryMoveFrames = 3;
          runStallFrames = 0;
          runLastDistance =
            Number.POSITIVE_INFINITY;
          lastInferenceTime = 0;
          currentAction = 0;

          setMode(
            previewIsTraining
              ? "TRAIN-RECOVER"
              : "RECOVER",
          );

          setState("RUNNING");

          snapshot.status =
            previewIsTraining
              ? "TRAIN PREVIEW / COLLISION RECOVERED"
              : "COLLISION RECOVERED / SAME MAP";

          setMessage(
            previewIsTraining
              ? "TRAIN PREVIEW / COLLISION / SAME MAP / CONTINUE"
              : "COLLISION / SAME MAP / CONTINUE",
          );

          syncWorldBuffers();
          syncSnapshot();
          return;
        }

        if (terminalSuccess) {
          /*
           * SUCCESS is intentionally different from COLLISION.
           * Reaching the target means the episode is complete, so
           * immediately generate a NEW MAP and continue autonomous
           * navigation without requiring another RUN command.
           */
          const previousSeed =
            finite(
              engine.current_seed(),
              0,
            );

          let nextSeed =
            (
              (Date.now() >>> 0) ^
              (
                Math.floor(
                  performance.now() * 1000,
                ) >>> 0
              )
            ) >>> 0;

          if (nextSeed === previousSeed) {
            nextSeed =
              (
                previousSeed +
                0x9e3779b9
              ) >>> 0;
          }

          engine.reset_environment(
            nextSeed,
          );

          recoveryMoveFrames = 3;
          runStallFrames = 0;
          runLastDistance =
            Number.POSITIVE_INFINITY;
          lastInferenceTime = 0;
          currentAction = 0;

          setMode(
            previewIsTraining
              ? "TRAIN-NEW-MAP"
              : "RUN-NEW-MAP",
          );
          setState("RUNNING");

          snapshot.status =
            previewIsTraining
              ? "TARGET REACHED / NEW MAP / TRAIN CONTINUE"
              : "TARGET REACHED / NEW MAP / RUN CONTINUE";

          setMessage(
            previewIsTraining
              ? "TARGET REACHED / NEW MAP / TRAINING CONTINUES"
              : "TARGET REACHED / NEW MAP / AUTONOMOUS CONTINUES",
          );

          syncWorldBuffers();
          syncSnapshot();
          return;
        }

        /*
         * Defensive fallback for an unexpected terminal state.
         * Keep the same map when possible by reusing the current seed.
         */
        if (
          runMode ||
          previewIsTraining
        ) {
          engine.reset_environment(
            finite(
              engine.current_seed(),
              Date.now() >>> 0,
            ),
          );

          recoveryMoveFrames = 3;
          runStallFrames = 0;
          runLastDistance =
            Number.POSITIVE_INFINITY;
          lastInferenceTime = 0;
          currentAction = 0;

          setMode(
            previewIsTraining
              ? "TRAIN-RECOVER"
              : "RECOVER",
          );

          setState("RUNNING");

          snapshot.status =
            previewIsTraining
              ? "TRAIN PREVIEW / TERMINAL RECOVERED"
              : "TERMINAL RECOVERED / SAME MAP";

          setMessage(
            previewIsTraining
              ? "TRAIN PREVIEW / TERMINAL / RECOVER / CONTINUE"
              : "TERMINAL / RECOVER / CONTINUE",
          );

          syncWorldBuffers();
          syncSnapshot();
          return;
        }
      }

      const agentNow = parseAgent();
      const targetNow = parseTarget();

      const dxNow =
        targetNow.x - agentNow.x;

      const dzNow =
        targetNow.z - agentNow.z;

      const distanceNow =
        Math.hypot(dxNow, dzNow);

      /*
       * After a collision we deliberately force FORWARD for a few frames.
       * This is the critical part that prevents a recovered training preview
       * from sitting at its start point waiting for another BRAKE decision.
       */
      let predictedAction =
        recoveryMoveFrames > 0
          ? 0
          : clampInt(
              engine.predict_action(),
              0,
              4,
            );

      /*
       * BRAKE is valid for learning, but a foreground preview must not use
       * BRAKE as a self-locking action when speed is already low.
       */
      if (
        predictedAction === 3
      ) {
        predictedAction = 0;
      }

      const distanceImproved =
        Number.isFinite(runLastDistance) &&
        distanceNow <
          runLastDistance -
          0.002;

      if (distanceImproved) {
        runStallFrames = 0;
      } else {
        runStallFrames += 1;
      }

      /*
       * Anti-stall applies to RUN and TRAIN PREVIEW.
       */
      if (
        recoveryMoveFrames <= 0 &&
        runStallFrames >= 12
      ) {
        const observation =
          safeBuffer(
            engine.get_observation(),
          );

        const targetSin =
          finite(observation[33]);

        if (
          Math.abs(targetSin) > 0.12
        ) {
          predictedAction =
            targetSin > 0
              ? 2
              : 1;
        } else {
          predictedAction = 0;
        }

        runStallFrames = 0;
      }

      runLastDistance =
        distanceNow;

      currentAction =
        predictedAction;

      const result =
        safeBuffer(
          engine.step(
            currentAction,
          ),
        );

      if (
        recoveryMoveFrames > 0
      ) {
        recoveryMoveFrames -= 1;
      }

      const reward =
        finite(result[0]);

      const done =
        finite(result[1]) > 0.5;

      const success =
        finite(result[2]) > 0.5;

      const collision =
        finite(result[3]) > 0.5;

      const distance =
        finite(result[4]);

      syncWorldBuffers();

      if (!done) {
        return;
      }

      const terminalEpisode =
        finite(
          engine.current_episode(),
        );

      emit(
        "raytracer:ai-episode",
        {
          episode:
            terminalEpisode,

          reward,
          success,
          collision,
          distance,
          action:
            currentAction,

          source:
            previewIsTraining
              ? "training-preview"
              : "run",
        },
      );

      /*
       * Collision is ALWAYS recoverable in the foreground visualizer.
       * The worker still treats it as a terminal DQN experience.
       */
      if (
        collision &&
        (
          runMode ||
          previewIsTraining
        )
      ) {
        engine.recover_from_collision();

        recoveryMoveFrames = 3;
        runStallFrames = 0;
        runLastDistance =
          Number.POSITIVE_INFINITY;
        lastInferenceTime = 0;
        currentAction = 0;

        setMode(
          previewIsTraining
            ? "TRAIN-RECOVER"
            : "RECOVER",
        );

        setState("RUNNING");

        snapshot.status =
          previewIsTraining
            ? "TRAIN PREVIEW / COLLISION RECOVERED"
            : "COLLISION RECOVERED / SAME MAP";

        setMessage(
          previewIsTraining
            ? "TRAIN PREVIEW / COLLISION / SAME MAP / CONTINUE"
            : "COLLISION / SAME MAP / CONTINUE",
        );

        syncWorldBuffers();
        syncSnapshot();
        return;
      }

      /*
       * Success completes the current episode. Unlike collision, it
       * immediately rolls into a completely NEW map and continues.
       */
      if (success) {
        const previousSeed =
          finite(
            engine.current_seed(),
            0,
          );

        let nextSeed =
          (
            (Date.now() >>> 0) ^
            (
              Math.floor(
                performance.now() * 1000,
              ) >>> 0
            )
          ) >>> 0;

        if (nextSeed === previousSeed) {
          nextSeed =
            (
              previousSeed +
              0x9e3779b9
            ) >>> 0;
        }

        engine.reset_environment(
          nextSeed,
        );

        recoveryMoveFrames = 3;
        runStallFrames = 0;
        runLastDistance =
          Number.POSITIVE_INFINITY;
        lastInferenceTime = 0;
        currentAction = 0;

        setMode(
          previewIsTraining
            ? "TRAIN-NEW-MAP"
            : "RUN-NEW-MAP",
        );
        setState("RUNNING");

        snapshot.status =
          previewIsTraining
            ? "TARGET REACHED / NEW MAP / TRAIN CONTINUE"
            : "TARGET REACHED / NEW MAP / RUN CONTINUE";

        setMessage(
          previewIsTraining
            ? "TARGET REACHED / NEW MAP / TRAINING CONTINUES"
            : "TARGET REACHED / NEW MAP / AUTONOMOUS CONTINUES",
        );

        syncWorldBuffers();
        syncSnapshot();
        return;
      }

      /*
       * Max-step/unknown terminal: recover rather than freezing the preview.
       */
      if (
        runMode ||
        previewIsTraining
      ) {
        engine.reset_environment(
          finite(
            engine.current_seed(),
            Date.now() >>> 0,
          ),
        );

        recoveryMoveFrames = 3;
        runStallFrames = 0;
        runLastDistance =
          Number.POSITIVE_INFINITY;
        lastInferenceTime = 0;
        currentAction = 0;

        setMode(
          previewIsTraining
            ? "TRAIN-RECOVER"
            : "RECOVER",
        );

        setState("RUNNING");

        snapshot.status =
          previewIsTraining
            ? "TRAIN PREVIEW / TERMINAL RECOVERED"
            : "TERMINAL RECOVERED / SAME MAP";

        setMessage(
          previewIsTraining
            ? "TRAIN PREVIEW / TERMINAL / RECOVER / CONTINUE"
            : "TERMINAL / RECOVER / CONTINUE",
        );

        syncWorldBuffers();
        syncSnapshot();
      }
    } catch (error) {
      handleRuntimeError(
        error,
      );
    }
  }

  function animationFrame(
    timestamp: number,
  ): void {
    if (
      destroyed
    ) {
      return;
    }

    if (
      lastRenderTime > 0
    ) {
      const delta =
        timestamp -
        lastRenderTime;

      if (
        delta > 0
      ) {
        const instantaneous =
          1000 /
          delta;

        fps =
          fps * 0.90 +
          instantaneous * 0.10;
      }
    }

    lastRenderTime =
      timestamp;

    renderCount +=
      1;

    if (
      engine &&
      initialized &&
      (runMode || trainingPreview) &&
      !evaluation &&
      (
        lastInferenceTime ===
        0 ||
        timestamp -
          lastInferenceTime >=
          INFERENCE_INTERVAL_MS
      )
    ) {
      lastInferenceTime =
        timestamp;

      runOneInferenceStep();
    }

    if (
      engine &&
      initialized &&
      !training &&
      !evaluation &&
      timestamp -
        lastTelemetryTime >=
        TELEMETRY_INTERVAL_MS
    ) {
      lastTelemetryTime =
        timestamp;

      syncSnapshot();
    }

    renderWebGPU(timestamp);
    drawWorld();

    frameHandle =
      requestAnimationFrame(
        animationFrame,
      );
  }

