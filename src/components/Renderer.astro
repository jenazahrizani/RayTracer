  function trainingStepCount(): number {
    if (
      engine &&
      typeof engine.training_step_count === "function"
    ) {
      return finite(
        engine.training_step_count(),
      );
    }

    if (engine) {
      try {
        const metrics =
          safeBuffer(
            engine.metrics(),
          );

        return finite(
          metrics[1],
        );
      } catch {
        // Older wasm builds may not expose metrics either.
      }
    }

    return snapshot.trainingSteps;
  }

  function safeBuffer(
    value: unknown,
  ): number[] {
    if (
      value === null ||
      value === undefined
    ) {
      return [];
    }

    if (
      Array.isArray(
        value,
      )
    ) {
      return value.map(
        (item) =>
          finite(item),
      );
    }

    if (
      ArrayBuffer.isView(
        value,
      )
    ) {
      const view =
        value as unknown as ArrayLike<unknown>;

      return Array.from(
        {
          length:
            view.length,
        },
        (_, index) =>
          finite(
            view[index],
          ),
      );
    }

    if (
      typeof value ===
        "object" &&
      value !== null &&
      Symbol.iterator in
        value
    ) {
      return Array.from(
        value as Iterable<unknown>,
        (item) =>
          finite(item),
      );
    }

    return [];
  }

  function syncWorldBuffers(): void {
    if (!engine) {
      return;
    }

    try {
      sensorBuffer =
        safeBuffer(
          engine.get_sensor_buffer(),
        );

      agentBuffer =
        safeBuffer(
          engine.get_agent_buffer(),
        );

      targetBuffer =
        safeBuffer(
          engine.get_target_buffer(),
        );

      obstacleBuffer =
        safeBuffer(
          engine.get_obstacle_buffer(),
        );

      pathBuffer =
        safeBuffer(
          engine.get_path_buffer(),
        );

      calculateWorldBounds();
    } catch (error) {
      handleRuntimeError(
        error,
      );
    }
  }

  function syncSnapshot(): void {
    if (!engine) {
      return;
    }

    try {
      snapshot.backend =
        engine.backend();

      snapshot.version =
        engine.version();

      snapshot.seed =
        finite(
          engine.current_seed(),
        );

      snapshot.step =
        finite(
          engine.current_step(),
        );

      snapshot.trainingSteps =
        finite(
          trainingStepCount(),
        );

      snapshot.episode =
        finite(
          engine.current_episode(),
        );

      snapshot.episodeSteps =
        finite(
          engine.last_episode_steps(),
        );

      snapshot.reward =
        finite(
          engine.last_reward(),
        );

      snapshot.episodeReward =
        finite(
          engine.last_episode_reward(),
        );

      snapshot.loss =
        finite(
          engine.last_loss(),
        );

      snapshot.epsilon =
        finite(
          engine.epsilon(),
        );

      snapshot.learningRate =
        finite(
          engine.learning_rate(),
        );

      snapshot.gamma =
        finite(
          engine.gamma(),
        );

      snapshot.replay =
        finite(
          engine.replay_size(),
        );

      snapshot.success =
        engine.is_success();

      snapshot.collision =
        engine.is_collision();

      snapshot.done =
        engine.is_done();

      snapshot.sensorCount =
        finite(
          engine.sensor_count(),
        );

      snapshot.observationSize =
        finite(
          engine.observation_size(),
        );

      snapshot.actionCount =
        finite(
          engine.action_count(),
        );

      snapshot.parameterCount =
        finite(
          engine.model_parameter_count(),
        );

      snapshot.obstacleCount =
        finite(
          engine.obstacle_count(),
        );

      if (
        snapshot.state !==
          "ERROR" &&
        snapshot.status ===
          "INITIALIZING"
      ) {
        snapshot.status =
          "READY";
      }

      syncWorldBuffers();
      emitAIState();
      renderRuntime();
    } catch (error) {
      handleRuntimeError(
        error,
      );
    }
  }

  function emitAIState(): void {
    const detail = {
      ...snapshot,

      mode:
        snapshot.mode,

      state:
        snapshot.state,

      backend:
        snapshot.backend,

      version:
        snapshot.version,

