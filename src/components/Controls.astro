  function syncFromExternal(detail: EventDetail): void {
    const incoming = detail?.state;

    if (!incoming || typeof incoming !== "object") {
      return;
    }

    const source = incoming as Partial<ControlState>;

    for (const key of Object.keys(DEFAULT_STATE) as Array<
      keyof ControlState
    >) {
      if (source[key] !== undefined) {
        (state[key] as ControlState[typeof key]) =
          source[key] as ControlState[typeof key];
      }
    }

    markDirty(Boolean(detail?.dirty ?? dirty));
    setMode(String(detail?.mode ?? memberMode));
    setStatus(String(detail?.status ?? commandStatus));
    refreshSource();
  }

  function handleExternalCommand(event: Event): void {
    const custom = event as CustomEvent<EventDetail>;
    const command = custom.detail?.command;

    if (typeof command === "string" && command.trim()) {
      execute(command);
    }
  }

  commandSubmit.addEventListener("click", () => {
    const value = commandInput.value.trim();

    if (!value) {
      commandInput.focus();
      return;
    }

    execute(value);
    commandInput.value = "";
    commandInput.focus();
  });

  commandInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      commandSubmit.click();
      return;
    }

    if (event.key === "ArrowUp") {
      event.preventDefault();

      if (!commandHistory.length) return;

      historyIndex = Math.min(historyIndex + 1, commandHistory.length - 1);

      commandInput.value =
        commandHistory[historyIndex] ?? "";
      commandInput.setSelectionRange(
        commandInput.value.length,
        commandInput.value.length,
      );

      return;
    }

    if (event.key === "ArrowDown") {
      event.preventDefault();

      if (!commandHistory.length) return;

      historyIndex = Math.max(historyIndex - 1, -1);

      commandInput.value =
        historyIndex === -1
          ? ""
          : commandHistory[historyIndex] ?? "";

      commandInput.setSelectionRange(
        commandInput.value.length,
        commandInput.value.length,
      );
    }
  });

  window.addEventListener(
    "raytracer:controls-command",
    handleExternalCommand,
  );

  window.addEventListener(
    "raytracer:controls-sync",
    (event) => {
      syncFromExternal(
        (event as CustomEvent<EventDetail>).detail ?? {},
      );
    },
  );

  window.addEventListener(
    "raytracer:controls-open",
    () => {
      const section = document.getElementById("controls");

      if (!section) return;

      section.classList.add("controls-visible");
      section.setAttribute("aria-hidden", "false");

      setMode("OPEN");
      setStatus("OPEN");
      refreshSource();
      commandInput.focus();
    },
  );

  window.addEventListener(
    "raytracer:controls-close",
    () => {
      const section = document.getElementById("controls");

      if (!section) return;

      section.classList.remove("controls-visible");
      section.setAttribute("aria-hidden", "true");

      setMode("READY");
      setStatus("CLOSED");
    },
  );

  window.addEventListener(
    "raytracer:ai-state",
    (event) => {
      const detail = (event as CustomEvent<EventDetail>).detail ?? {};

      dispatch("raytracer:controls-ai-state", {
        ...detail,
        source: "controls",
      });
    },
  );

  const api = {
    getState(): ControlState {
      return cloneState(state);
    },

    setState(next: Partial<ControlState>): void {
      Object.assign(state, next);
      markDirty(true);
      setMode("EDIT");
      setStatus("EXTERNAL STATE UPDATE");
      refreshSource();
    },

    execute,

    status(): ControlState & {
      dirty: boolean;
      mode: string;
      commandStatus: string;
    } {
      return {
        ...cloneState(state),
        dirty,
        mode: memberMode,
        commandStatus,
      };
    },

    reset(): void {
      resetStateOnly();
    },

    apply(): void {
      execute("APPLY");
    },

    open(): void {
      dispatch("raytracer:controls-open");
    },

    close(): void {
      dispatch("raytracer:controls-close");
    },

    ai(action: string, payload: EventDetail = {}): void {
      emitAI(action, payload);
    },
  };

  (
    window as typeof window & {
      RayTracerControls?: typeof api;
    }
  ).RayTracerControls = api;

  markDirty(false);
  setMode("READY");
  setStatus("READY");
  refreshSource();
</script>